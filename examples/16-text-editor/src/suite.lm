# Unit tests for the pure parts of the editor.
#
# Run them with `lm test examples/16-text-editor`.
# The runner finds each `Test` class here. It runs every test method
# in its own child VM.

use std.test
use document
use editor
use main
use text

# Render one search result as text, so a test can compare it.
def at(found: Option[(Int, Int)]): String
  case found
  in Some(position) then "#{position.0},#{position.1}"
  in None then "none"
  end
end

def sample(): Result[document.Document, test.TestFailure]
  case document.parse(b"abc\nb\n", None)
  in Ok(doc) then Ok(doc)
  in Err(message) then test.fail(message)
  end
end

class TextTest implements Test
  def clip_stays_inside_the_line(self): Result[(), test.TestFailure]
    test.equal("bc", text.clip("abcd", 1, 2))?
    test.equal("cd", text.clip("abcd", 2, 10))?
    test.equal("", text.clip("abcd", 9, 2))?
    test.equal("ab", text.clip("abcd", -3, 2))
  end

  def head_and_tail_count_scalars(self): Result[(), test.TestFailure]
    test.equal("hé", text.head_of("héllo", 2))?
    test.equal("llo", text.tail_of("héllo", 2))?
    test.equal("", text.tail_of("abc", 9))?
    test.equal("", text.head_of("abc", -1))
  end

  def drop_last_never_fails(self): Result[(), test.TestFailure]
    test.equal("ab", text.drop_last("abc"))?
    test.equal("", text.drop_last(""))
  end

  def tabs_expand_to_the_next_stop(self): Result[(), test.TestFailure]
    test.equal("a   b", "#{text.expand_tabs("a\tb")}")?
    test.equal("    x", "#{text.expand_tabs("\tx")}")?
    test.equal("plain", "#{text.expand_tabs("plain")}")
  end

  def screen_column_counts_tab_width(self): Result[(), test.TestFailure]
    test.equal(4, text.screen_column("a\tb", 2))?
    test.equal(3, text.screen_column("abc", 10))?
    test.equal(0, text.screen_column("abc", 0))
  end

  def wrap_index_wraps_both_ways(self): Result[(), test.TestFailure]
    test.equal(2, text.wrap_index(-1, 3))?
    test.equal(2, text.wrap_index(5, 3))?
    test.equal(0, text.wrap_index(1, 0))
  end

  def tab_spaces_reach_the_stop(self): Result[(), test.TestFailure]
    test.equal(4, text.tab_spaces(0))?
    test.equal(3, text.tab_spaces(5))?
    test.equal(10, text.clamp(15, 0, 10))?
    test.equal(0, text.clamp(-2, 0, 10))
  end
end

class DocumentTest implements Test
  def parse_splits_lines(self): Result[(), test.TestFailure]
    doc = sample()?
    test.equal(2, doc.line_count())?
    test.equal("b", doc.line(1))?
    test.equal("", doc.line(5))
  end

  def parse_rejects_bad_utf8(self): Result[(), test.TestFailure]
    test.expect(document.parse(b"\xff", None).is_err(), "invalid bytes parsed")
  end

  def an_empty_document_has_one_line(self): Result[(), test.TestFailure]
    doc = document.empty(None)
    test.equal(1, doc.line_count())?
    test.equal("[no name]", doc.name())?
    test.expect(not doc.dirty, "a new document is dirty")
  end

  def edits_change_one_line(self): Result[(), test.TestFailure]
    doc = document.empty(None)
    doc.insert_text(0, 0, "ab")
    doc.insert_text(0, 1, "X")
    test.equal("aXb", doc.line(0))?
    test.expect(doc.remove_at(0, 1), "remove inside the line failed")?
    test.expect(not doc.remove_at(0, 5), "remove outside the line succeeded")?
    test.equal("ab", doc.line(0))?
    test.expect(doc.dirty, "an edit left the document clean")
  end

  def split_and_join_are_inverse(self): Result[(), test.TestFailure]
    doc = document.empty(None)
    doc.insert_text(0, 0, "ab")
    doc.split_line(0, 1)
    test.equal(2, doc.line_count())?
    test.equal("a", doc.line(0))?
    test.equal("b", doc.line(1))?
    test.equal(1, doc.join_next(0))?
    test.equal("ab", doc.line(0))?
    test.equal(-1, doc.join_next(0))?
    test.expect(doc.bytes() == b"ab\n", "the file bytes changed")
  end
end

class SearchTest implements Test
  def match_after_scans_forward_and_wraps(self): Result[(), test.TestFailure]
    doc = sample()?
    test.equal("0,1", at(editor.match_after(doc, "b", 0, 0)))?
    test.equal("1,0", at(editor.match_after(doc, "b", 0, 2)))?
    test.equal("0,1", at(editor.match_after(doc, "b", 1, 1)))?
    test.equal("none", at(editor.match_after(doc, "zz", 0, 0)))
  end

  def match_before_scans_backward_and_wraps(self): Result[(), test.TestFailure]
    doc = sample()?
    test.equal("1,0", at(editor.match_before(doc, "b", 1, 0)))?
    test.equal("1,0", at(editor.match_before(doc, "b", 0, 0)))?
    test.equal("0,1", at(editor.match_before(doc, "b", 0, 3)))
  end

  def last_match_respects_the_limit(self): Result[(), test.TestFailure]
    test.equal(1, editor.last_match_upto("abab", "b", 2))?
    test.equal(3, editor.last_match_upto("abab", "b", 3))?
    test.equal(-1, editor.last_match_upto("abab", "b", -1))?
    test.equal(-1, editor.last_match_upto("abab", "z", 3))
  end
end

class EditorTest implements Test
  def the_cursor_moves_across_lines(self): Result[(), test.TestFailure]
    state = editor.Editor(sample()?)
    state.move_right()
    state.move_right()
    state.move_right()
    test.equal(3, state.column)?
    state.move_right()
    test.equal("1,0", "#{state.row},#{state.column}")?
    state.move_left()
    test.equal("0,3", "#{state.row},#{state.column}")?
    state.move_down()
    test.equal("1,1", "#{state.row},#{state.column}")?
    state.move_down()
    test.equal(1, state.row)?
    state.move_up()
    test.equal("0,3", "#{state.row},#{state.column}")
  end

  def resize_keeps_a_usable_view(self): Result[(), test.TestFailure]
    state = editor.Editor(document.empty(None))
    state.resize(10, 1)
    test.equal(20, state.view_columns)?
    test.equal(1, state.view_rows)
  end

  def edits_reach_the_document(self): Result[(), test.TestFailure]
    state = editor.Editor(sample()?)
    state.move_end()
    state.insert("Z")
    test.equal("abcZ", state.doc.line(0))?
    state.backspace()
    test.equal("abc", state.doc.line(0))?
    state.insert("\n")
    test.equal("abc", state.doc.line(0))?
    state.insert_newline()
    test.equal(3, state.doc.line_count())?
    state.backspace()
    test.equal(2, state.doc.line_count())?
    test.equal("0,3", "#{state.row},#{state.column}")?
    state.delete()
    test.equal("abcb", state.doc.line(0))?
    state.move_home()
    state.insert_tab()
    test.equal("    abcb", state.doc.line(0))
  end
end

# ---- end-to-end sessions --------------------------------------
#
# The tests below run the real editor loop in a child VM. The test
# drives that VM and answers every operation itself. It supplies the
# keys one read at a time, reports one terminal size, keeps every
# frame, and refuses the file system. No terminal and no file exist,
# and each run gives the same frames.

# One editor session over one document. The entry that `lm run`
# uses adds the terminal checks and raw mode around this loop.
def session(doc: document.Document): (Bytes, String) with Clock.Sleep, Fs, Io, Tty, Wait
  state = editor.Editor(doc)
  main.edit_loop(state, Tty())
  (state.doc.bytes(), state.message)
end

# What one driven session produced.
final class SessionReport
  bytes: Bytes
  message: String
  frames: List[Bytes]
  transcript: List[String]

  def init(mut self, bytes: Bytes, message: String, frames: List[Bytes], transcript: List[String])
    self.bytes = bytes
    self.message = message
    self.frames = frames
    self.transcript = transcript
  end

  # The document text after the session.
  def text(self): String
    case self.bytes.utf8()
    in Ok(value) then value.to_string()
    in Err(_) then ""
    end
  end

  # One drawn frame as text. Frame 0 precedes the first key.
  def frame(self, index: Int): String
    case self.frames.get(index)
    in None then ""
    in Some(bytes)
      case bytes.utf8()
      in Ok(value) then value.to_string()
      in Err(_) then ""
      end
    end
  end

  # Report whether any drawn frame contains `needle`.
  def drew(self, needle: Text): Bool
    index = 0
    while index < self.frames.len()
      if self.frame(index).contains(needle) then return true end
      index = index + 1
    end
    false
  end

  def performed(self, name: Text): Int
    count = 0
    for entry in self.transcript
      if entry == name then count = count + 1 end
    end
    count
  end
end

# Drive one session. Each read receives the next chunk of `script`.
# After the last chunk a read receives no bytes, which ends the
# editor loop. Each write is one frame. A save reaches no file: the
# driver answers the open request with an error.
def drive_session(doc: document.Document, script: List[Bytes]): Result[SessionReport, test.TestFailure] with Vm
  run = sys.vm.Vm().activate_or_fault(session, args: (doc,))
  frames = List[Bytes]()
  transcript = List[String]()
  next = 0
  loop do
    case run.drive()
    in Asked(request)
      transcript.push(request.op_name())
      case request
      in Call(Io.ReadBytes, call, (_count,))
        chunk = if next < script.len() then script.at(next) else Bytes("") end
        next = next + 1
        run.answer(call, Ok(chunk))
      in Call(Io.Write, call, (bytes,))
        frames.push(bytes)
        run.answer(call, Ok(bytes.len()))
      in Call(Tty.Size, call, (_stream,))
        run.answer(call, Ok(TtySize(40, 6)))
      in Call(Fs.Open, call, (_path, _options))
        run.answer(call, Err(FsError.Failed("the test has no file system")))
      in _
        run.dispatch(request)
      end
    in Done((bytes, message))
      return Ok(SessionReport(bytes, message, frames, transcript))
    in Fault(problem)
      return test.fail("the session faulted with #{problem.code()}")
    end
  end
end

def sample_file(): Result[document.Document, test.TestFailure]
  document.parse(b"alpha\nbeta\ngamma\n", Some("notes.txt")).map_error() { |m: String| test.TestFailure(m) }
end

class SessionTest implements Test
  # Down, Ctrl-E, `!`, Enter, `gamma`, Ctrl-S, one key for each read.
  # The editor draws one frame after each key. The status line shows
  # the cursor, the modified marker, and the line count.
  def each_key_draws_one_frame(self): Result[(), test.TestFailure] with Vm
    report = drive_session(
      sample_file()?,
      [b"\x1b[B", b"\x05", b"!", b"\r", b"gamma", b"\x13"]
    )?
    test.equal(7, report.frames.len())?
    test.equal(7, report.performed("Io.ReadBytes"))?
    test.equal("Tty.Size", report.transcript.at(0))?
    test.expect(report.frame(0).contains("1:1  3 lines"), "the first frame is not at the start")?
    test.expect(report.frame(1).contains("2:1  3 lines"), "Down did not move to the second line")?
    test.expect(report.frame(2).contains("2:5  3 lines"), "Ctrl-E did not reach the line end")?
    test.expect(report.frame(3).contains("beta!"), "the typed character is not drawn")?
    test.expect(report.frame(3).contains("(modified)"), "the edit did not mark the file")?
    test.expect(report.frame(4).contains("3:1  4 lines"), "Enter did not split the line")?
    test.expect(report.frame(5).contains("3:6  4 lines"), "typing did not advance the cursor")?
    test.expect(report.frame(6).contains("save failed"), "the refused save left no message")?
    test.equal(1, report.performed("Fs.Open"))?
    test.equal("alpha\nbeta!\ngamma\ngamma\n", report.text())
  end

  # The same keys in one read are a burst. The editor applies the
  # burst first and draws one frame after it.
  def a_burst_draws_one_frame_after_the_keys(self): Result[(), test.TestFailure] with Vm
    report = drive_session(sample_file()?, [b"\x1b[B\x05!\rgamma\x13"])?
    test.equal(2, report.frames.len())?
    test.expect(report.frame(1).contains("save failed"), "the burst frame lacks the last message")?
    test.equal("alpha\nbeta!\ngamma\ngamma\n", report.text())
  end

  # Ctrl-F, then `beta` one key at a time. The prompt grows with
  # each key, and the frame inverts the current match.
  def an_incremental_search_marks_each_match(self): Result[(), test.TestFailure] with Vm
    report = drive_session(sample_file()?, [b"\x06", b"b", b"e", b"t", b"a"])?
    test.equal(6, report.frames.len())?
    test.expect(report.frame(1).contains("Find:    arrows"), "Ctrl-F drew no empty prompt")?
    test.expect(report.frame(2).contains("Find: b "), "the first key did not reach the prompt")?
    test.expect(report.frame(2).contains("\x1b[7mb\x1b[0m"), "the first match is not inverted")?
    test.expect(report.frame(5).contains("\x1b[7mbeta\x1b[0m"), "the full match is not inverted")?
    test.equal(0, report.performed("Fs.Open"))
  end

  # One Ctrl-Q on a changed document asks for confirmation. A second
  # Ctrl-Q ends the loop before the editor reads or draws again.
  def quitting_a_changed_document_needs_confirmation(self): Result[(), test.TestFailure] with Vm
    once = drive_session(sample_file()?, [b"x", b"\x11"])?
    test.expect(once.frame(2).contains("unsaved changes"), "the first Ctrl-Q asked nothing")?
    test.equal(3, once.performed("Io.ReadBytes"))?
    twice = drive_session(sample_file()?, [b"x", b"\x11", b"\x11"])?
    test.equal(3, twice.performed("Io.ReadBytes"))?
    test.equal(3, twice.frames.len())?
    test.equal("xalpha\nbeta\ngamma\n", twice.text())
  end

  # A session with no keys draws one frame and ends when input ends.
  def an_empty_session_draws_once_and_ends(self): Result[(), test.TestFailure] with Vm
    report = drive_session(sample_file()?, List[Bytes]())?
    test.equal(1, report.frames.len())?
    test.equal(1, report.performed("Io.ReadBytes"))?
    test.equal("alpha\nbeta\ngamma\n", report.text())
  end
end
