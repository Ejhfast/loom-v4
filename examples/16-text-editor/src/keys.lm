# Key decoding for the editor.
#
# A terminal sends bytes. This module turns one byte prefix into one
# key. It reports `NeedMore` when the prefix is not complete yet.

enum Key
  Text(value: String)
  Control(letter: Int)
  Enter
  Tab
  Backspace
  Delete
  Escape
  Up
  Down
  Left
  Right
  Home
  End
  PageUp
  PageDown
  Unsupported
end

enum KeyRead
  Ready(key: Key, consumed: Int)
  NeedMore
end

# Return the control byte of one lowercase ASCII letter.
# `control_of("q")` is the byte that Ctrl-Q sends.
def control_of(letter: Text): Int
  case letter.at(0)
  in Some(scalar) then scalar.codepoint() - 96
  in None         then 0
  end
end

# Return the byte count of one UTF-8 scalar, or 0 for an invalid lead.
def scalar_width(lead: Int): Int
  if lead < 128
    1
  elsif lead >= 194 and lead <= 223
    2
  elsif lead >= 224 and lead <= 239
    3
  elsif lead >= 240 and lead <= 244
    4
  else
    0
  end
end

# Decode the first key of `input`.
# Set `finish` after an escape timeout or at the end of the input.
def decode(input: Bytes, finish: Bool): KeyRead
  if input.is_empty()
    return NeedMore
  end
  first = input.at(0)
  if first == 27
    return decode_escape(input, finish)
  end
  if first == 13 or first == 10
    return Ready(Key.Enter, 1)
  end
  if first == 9
    return Ready(Key.Tab, 1)
  end
  if first == 8 or first == 127
    return Ready(Key.Backspace, 1)
  end
  if first < 32
    return Ready(Key.Control(first), 1)
  end
  decode_scalar(input, finish)
end

def decode_scalar(input: Bytes, finish: Bool): KeyRead
  width = scalar_width(input.at(0))
  if width == 0
    return Ready(Key.Unsupported, 1)
  end
  if input.len() < width
    if finish
      return Ready(Key.Unsupported, input.len())
    end
    return NeedMore
  end
  prefix = case input.slice(0, width)
  in Ok(bytes) then bytes
  in Err(_)
    return Ready(Key.Unsupported, 1)
  end
  case prefix.utf8()
  in Ok(text) then Ready(Key.Text(text), width)
  in Err(_)   then Ready(Key.Unsupported, 1)
  end
end

def decode_escape(input: Bytes, finish: Bool): KeyRead
  if input.len() == 1
    if finish
      return Ready(Key.Escape, 1)
    end
    return NeedMore
  end
  second = input.at(1)
  if second == 91
    return decode_csi(input, finish)
  end
  if second == 79
    return decode_ss3(input, finish)
  end
  Ready(Key.Unsupported, 2)
end

# Scan one control sequence: `ESC [`, parameters, then one final byte.
def decode_csi(input: Bytes, finish: Bool): KeyRead
  index = 2
  while index < input.len()
    byte = input.at(index)
    if byte >= 64 and byte <= 126
      return csi_key(input, index)
    end
    if byte < 32 or byte > 63
      return Ready(Key.Unsupported, index)
    end
    index = index + 1
  end
  if finish
    return Ready(Key.Unsupported, input.len())
  end
  NeedMore
end

def decode_ss3(input: Bytes, finish: Bool): KeyRead
  if input.len() < 3
    if finish
      return Ready(Key.Unsupported, input.len())
    end
    return NeedMore
  end
  Ready(code_key(input.at(2)), 3)
end

def csi_key(input: Bytes, last: Int): KeyRead
  code = input.at(last)
  if code == 126
    return Ready(tilde_key(csi_number(input, last)), last + 1)
  end
  Ready(code_key(code), last + 1)
end

# Read the first numeric parameter of one control sequence.
def csi_number(input: Bytes, last: Int): Int
  value = 0
  digits = 0
  index = 2
  while index < last
    byte = input.at(index)
    if byte < 48 or byte > 57
      break
    end
    value = value * 10 + (byte - 48)
    digits = digits + 1
    index = index + 1
  end
  if digits == 0
    return -1
  end
  value
end

def code_key(code: Int): Key
  if code == 65
    Key.Up
  elsif code == 66
    Key.Down
  elsif code == 67
    Key.Right
  elsif code == 68
    Key.Left
  elsif code == 70
    Key.End
  elsif code == 72
    Key.Home
  else
    Key.Unsupported
  end
end

def tilde_key(number: Int): Key
  if number == 1 or number == 7
    Key.Home
  elsif number == 3
    Key.Delete
  elsif number == 4 or number == 8
    Key.End
  elsif number == 5
    Key.PageUp
  elsif number == 6
    Key.PageDown
  else
    Key.Unsupported
  end
end
