# Checkpoint now: capture the child at once, whatever it holds.
#
# A snapshot cannot contain a live resource. The supervisor closes the
# child's open handles first, so the capture succeeds immediately.
#
# The child then reads a closed handle and recovers. A closed handle
# stays ordinary child state: it survives the snapshot and the restore,
# and it never reopens a path by itself.

def read_with_recovery(): String with Fs.Open, Fs.Read, Fs.Close
  case sys.fs.open("message.txt", ReadOnly)
  in Ok(file)
    case file.read(1024)
    in Ok(bytes)
      file.close()
      bytes.text()
    in Err(Closed)
      # The supervisor took this file. Open a fresh one.
      case sys.fs.open("message.txt", ReadOnly)
      in Ok(again)
        text = case again.read(1024)
        in Ok(bytes)  then bytes.text()
        in Err(error) then error.message()
        end
        again.close()
        "recovered {text}"
      in Err(error) then error.message()
      end
    in Err(error) then error.message()
    end
  in Err(error) then error.message()
  end
end

def close_every_handle(child: Run[String]): Int with Vm
  live = child.handles()
  closed = 0
  i = 0
  while i < live.len()
    if live[i].close()
      closed = closed + 1
    end
    i = i + 1
  end
  closed
end

def resume(image: Snapshot[String]): String with Vm, Fs
  case sys.vm.Vm().restore(image)
  in Ok(restored)
    # A restored machine starts default-deny. Grant it again.
    restored.table().pass(Fs)
    case restored.run()
    in Done(value) then value
    in Fault(_)    then "the restored child faulted"
    end
  in Err(_) then "the snapshot did not restore"
  end
end

def checkpoint_now(child: Run[String]): String with Vm, Fs
  # Let the open through. The host serves it asynchronously, so the
  # file appears only when the child reaches its next request.
  case child.drive()
  in Asked(open_request)
    child.dispatch(open_request)
    case child.drive()
    in Asked(read_request)
      # The child holds a live file here, so a capture must refuse.
      live = child.snapshot().is_ok()
      closed = close_every_handle(child)
      # Answer the read before the capture. A machine that holds a
      # request needs its driver, and a restored world has none.
      child.dispatch(read_request)
      case child.snapshot()
      in Ok(image)
        "live capture={live}, closed {closed}, restored: {resume(image)}"
      in Err(_) then "the closed handle still blocked the capture"
      end
    in Done(value)
      return value
    in Fault(_)
      return "the child faulted"
    end
  in Done(value)
    return value
  in Fault(_)
    return "the child faulted"
  end
end

child = sys.vm.Vm().activate(read_with_recovery, args: ())
child.table().pass(Fs)
checkpoint_now(child)
