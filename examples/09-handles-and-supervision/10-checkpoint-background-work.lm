# Checkpoint a background proc after its transient file closes.

def index_file(file: FileHandle): Int with Fs.Read, Fs.Close
  size = case file.read(1024)
  in Ok(bytes) then bytes.len()
  in Err(_)
    return -1
  end
  case file.close()
  in Ok(_)  then size
  in Err(_) then panic("the checkpoint failed")
  end
end

case sys.fs.open("message.txt", ReadOnly)
in Ok(file)
  # The new VM starts with one live file attachment.
  worker = sys.vm.Vm().activate_or_fault(index_file, args: (file,))
  worker.table().pass(Fs.Read)
  worker.table().pass(Fs.Close)

  # The scheduler now owns the worker VM.
  job = sys.proc.run(worker)

  # This call parks the root proc. The worker continues within the
  # fuel limit. Capture starts after the worker closes its file.
  checkpoint = case job.snapshot_wait(10000)
  in Ok(_)  then "captured after the file closed"
  in Err(_) then "the file stayed open"
  end

  result = case job.done()
  in Done(size) then "indexed {size} bytes"
  in Fault(_)   then "the index failed"
  end
  "{checkpoint}; {result}"
in Err(error) then display(error)
end
