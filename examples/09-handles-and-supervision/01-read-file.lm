# Read one file through an explicit file handle.

def read_file(path: Path): String with Fs.Open, Fs.Read, Fs.Close
  case sys.fs.open(path, ReadOnly)
  in Ok(file)
    case file.read(1024)
    in Ok(bytes)
      case file.close()
      in Ok(_)      then bytes.text()
      in Err(error) then display(error)
      end
    in Err(error)
      file.close()
      display(error)
    end
  in Err(error) then display(error)
  end
end

read_file(Path("message.txt", PathStyle.Posix))
