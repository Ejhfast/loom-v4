# A closed control is ordinary state.
#
# The supervisor serves a file for the child from memory and closes it.
# The supervisor keeps the control afterwards, inside a plain object
# field.
#
# `serve_file(call)` answers the pending `Fs.Open` and returns the
# holder-side `ResourceHandle` of the new entry. The control is the
# value this example retains. It stays valid after the entry closes,
# and it reports that state through `is_open`.
#
# A live resource blocks a capture. This control is closed, so it does
# not. The snapshot stores a closed marker with no host authority, and a
# restored marker stays closed.

class ServedRequest
  control: ResourceHandle
  text: String

  def init(mut self, control: ResourceHandle, text: String)
    self.control = control
    self.text = text
  end
end

def read_settings(): String with Fs.Open, Fs.Read, Fs.Close
  case sys.fs.open("settings.txt", ReadOnly)
  in Ok(file)
    text = case file.read(1024)
    in Ok(bytes)  then bytes.text()
    in Err(error) then error.message()
    end
    file.close()
    text
  in Err(error) then error.message()
  end
end

def serve(child: Run[String], mine: ResourceHandle, contents: Bytes): String with Vm
  loop do
    case child.drive()
    in Asked(request)
      case request
      in Call(Fs.Read, call, (file, _))
        if child.resource(file).same_resource(mine)
          child.answer(call, Ok(contents))
        else
          child.dispatch(request)
        end
      in Call(Fs.Close, call, (file,))
        if child.resource(file).same_resource(mine)
          child.answer(call, Ok(()))
        else
          child.dispatch(request)
        end
      in _
        child.dispatch(request)
      end
    in Done(value)
      return value
    in Fault(_)
      return "the child faulted"
    end
  end
end

child = sys.vm.Vm().activate_or_fault(read_settings, args: ())
case child.drive()
in Asked(request)
  case request
  in Call(Fs.Open, call, (_, _))
    mine = child.serve_file(call)
    served = ServedRequest(mine, serve(child, mine, Bytes("cached settings")))

    # The child closed the entry, so the retained control is closed.
    # `snapshot_self` therefore succeeds and keeps the closed marker.
    if served.control.is_open()
      "the served request still owns a live file"
    elsif sys.vm.snapshot_self().is_err()
      "the closed control blocked the capture"
    else
      served.text
    end
  in _ then "the child asked for something else first"
  end
in Done(_)  then "the child finished before it opened a file"
in Fault(_) then "the child faulted before it opened a file"
end
