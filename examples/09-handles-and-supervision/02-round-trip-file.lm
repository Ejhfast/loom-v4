# Write a file, then seek to its start and read it back.

def close_after_error(file: FileHandle, error: FsError): String with Fs.Close
  file.close()
  error.message()
end

def round_trip(path: String): String with Fs.Open, Fs.Write, Fs.Flush, Fs.Seek, Fs.Read, Fs.Close
  case sys.fs.open(path, CreateTruncate)
  in Ok(file)
    case file.write(Bytes("hello"))
    in Ok(_)      then ()
    in Err(error)
      return close_after_error(file, error)
    end

    case file.flush()
    in Ok(_)      then ()
    in Err(error)
      return close_after_error(file, error)
    end

    case file.seek(Start(0))
    in Ok(_)      then ()
    in Err(error)
      return close_after_error(file, error)
    end

    text = case file.read(5)
    in Ok(bytes)  then bytes.text()
    in Err(error)
      return close_after_error(file, error)
    end

    case file.close()
    in Ok(_)      then text
    in Err(error) then error.message()
    end
  in Err(error) then error.message()
  end
end

round_trip("round-trip.txt")
