# Deny with a fault: refuse a request whose reply carries no error.
#
# `04-deny.lm` answers `Err(Failed(...))`. That works because
# `Fs.Open` replies with a `Result`. Most operations do not. `Clock.Now`
# replies with `Int`, so a driver that must refuse it has no error
# value to send. A wildcard arm has no reply type at all.
#
# `Fault.denied(reason)` builds the one fault a program can make. Its
# code is always `PolicyDenied`, the same code that an advance `block`
# installs. `reject` then stops the child.
#
# A wildcard arm holds no operation identity, so `request.op_name()`
# names the operation as text for the reason. Read it before the
# continuation: `answer`, `reject`, `dispatch`, and `serve_file` each
# spend the request.

def read_clock(): String with Clock.Now, Io.Print
  sys.io.print("the child asks for the time\n")
  t = sys.clock.now()
  "the child read {t}"
end

def print_only(child: Run[String]): String with Vm, Io.Print
  loop do
    case child.drive()
    in Asked(request)
      case request
      in Call(Io.Print, call, (text,))
        sys.io.print("child: {text}")
        child.answer(call, ())
      in _
        # No `Int` here would be honest, so the driver refuses. The
        # reason names the operation it refused.
        denied = "{request.op_name()} is not permitted for this child"
        child.reject(request, Fault.denied(denied))
      end
    in Done(value)
      return value
    in Fault(fault)
      return "the child stopped with {fault.code()}"
    end
  end
end

child = sys.vm.Vm().activate_or_fault(read_clock, args: ())
print_only(child)
