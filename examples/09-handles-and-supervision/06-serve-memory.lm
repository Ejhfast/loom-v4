# Serve from memory: the child does ordinary file work, and no file
# exists.
#
# `mint_file` answers an `Fs.Open` with a fresh resource entry that the
# supervisor owns. No host file stands behind that entry. Every later
# operation on it therefore returns to the supervisor as a request, and
# the supervisor must answer all of them.

def read_settings(): String with Fs.Open, Fs.Read, Fs.Close
  case sys.fs.open("settings.txt", ReadOnly)
  in Ok(file)
    text = case file.read(1024)
    in Ok(bytes)  then bytes.text()
    in Err(error) then error.message()
    end
    file.close()
    text
  in Err(error) then error.message()
  end
end

def serve(child: Vm[String], mine: ResourceHandle, contents: Bytes): String with Vm
  loop do
    case child.drive()
    in Asked(request)
      case request.as_call(Fs.Read)
      in Some(call)
        # `resource` converts a child handle to a supervisor control.
        # `same_resource` reports whether this is the minted entry.
        if child.resource(call.args()[0]).same_resource(mine)
          child.answer(call, Ok(contents))
        else
          child.dispatch(request)
        end
      in None
        case request.as_call(Fs.Close)
        in Some(call)
          if child.resource(call.args()[0]).same_resource(mine)
            child.answer(call, Ok(()))
          else
            child.dispatch(request)
          end
        in None
          child.dispatch(request)
        end
      end
    in Done(value)
      return value
    in Fault(_)
      return "the child faulted"
    end
  end
  "the supervisor stopped"
end

child = sys.vm.Vm().from_fn(read_settings, args: ())

# The first request is the open. Mint an entry to answer it.
case child.drive()
in Asked(request)
  case request.as_call(Fs.Open)
  in Some(call)
    mine = child.mint_file(call)
    serve(child, mine, Bytes("settings from the supervisor"))
  in None then "the child asked for something else first"
  end
in Done(_)  then "the child finished before it opened a file"
in Fault(_) then "the child faulted before it opened a file"
end
