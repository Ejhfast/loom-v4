# Serve from memory: the child does ordinary file work, and no file
# exists.
#
# `serve_file(call)` does three things in one step:
#
# 1. It creates a file resource. The child owns the entry, so the entry
#    closes when the child ends. This supervisor backs it.
# 2. It answers the pending `Fs.Open` with `Ok(FileHandle)` in the
#    child. The call token is spent, so a later `answer` on the same
#    token faults the supervisor with `InvalidRequestToken`.
# 3. It returns a `ResourceHandle` to this supervisor. That control
#    reads and closes the same resource from the holder side.
#
# The name states the duty. No host file stands behind the entry, so
# every later `Fs.Read`, `Fs.Write`, or `Fs.Close` comes back here as a
# request, and this supervisor must answer each one. A request that
# reaches the root host instead gives the child an `FsError`.

def read_settings(): String with Fs.Open, Fs.Read, Fs.Close
  case sys.fs.open("settings.txt", ReadOnly)
  in Ok(file)
    text = case file.read(1024)
    in Ok(bytes)  then bytes.text()
    in Err(error) then error.message()
    end
    file.close()
    text
  in Err(error) then error.message()
  end
end

def serve(child: Run[String], mine: ResourceHandle, contents: Bytes): String with Vm
  loop do
    case child.drive()
    in Asked(request)
      # One `case` reads every operation this driver serves. Each arm
      # names the operation, binds the call, and destructures its
      # arguments.
      case request
      in Call(Fs.Read, call, (file, _))
        # `resource` converts a child handle to a supervisor control.
        # `same_resource` reports whether this is the minted entry.
        if child.resource(file).same_resource(mine)
          child.answer(call, Ok(contents))
        else
          child.dispatch(request)
        end
      in Call(Fs.Close, call, (file,))
        if child.resource(file).same_resource(mine)
          child.answer(call, Ok(()))
        else
          child.dispatch(request)
        end
      in _
        child.dispatch(request)
      end
    in Done(value)
      return value
    in Fault(_)
      return "the child faulted"
    end
  end
end

child = sys.vm.Vm().activate_or_fault(read_settings, args: ())

# The first request is the open. `serve_file` answers it and returns
# the holder-side control of the new entry.
case child.drive()
in Asked(request)
  case request
  in Call(Fs.Open, call, (_, _))
    mine = child.serve_file(call)
    serve(child, mine, Bytes("settings from the supervisor"))
  in _ then "the child asked for something else first"
  end
in Done(_)  then "the child finished before it opened a file"
in Fault(_) then "the child faulted before it opened a file"
end
