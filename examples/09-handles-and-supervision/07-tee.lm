# Tee: serve the child's file, back it with a real file, and record the
# size of every read.
#
# This joins the two previous ideas. The child reads real data. The
# supervisor sees each operation and can change the answer.
#
# `serve_file(call)` answers the pending `Fs.Open` with a new entry and
# returns the holder-side `ResourceHandle` of that entry. It spends the
# call token, so the supervisor must not answer the same call again.
# It also takes on the duty: every later operation on that entry
# arrives here as a request. This example forwards each read to a real
# file, so the child sees genuine bytes and the supervisor sees sizes.

def read_twice(): String with Fs.Open, Fs.Read, Fs.Close
  case sys.fs.open(Path("input.txt", PathStyle.Posix), ReadOnly)
  in Ok(file)
    first = case file.read(6)
    in Ok(bytes)  then bytes.text()
    in Err(error) then display(error)
    end
    second = case file.read(6)
    in Ok(bytes)  then bytes.text()
    in Err(error) then display(error)
    end
    file.close()
    "#{first}+#{second}"
  in Err(error) then display(error)
  end
end

def tee(
  child: Run[String],
  mine: ResourceHandle,
  backing: FileHandle,
  mut sizes: [Int]
): String with Vm, Fs.Read
  loop do
    case child.drive()
    in Asked(request)
      # Each arm names an operation and binds its arguments, so the
      # read count arrives without reading an argument tuple by index.
      case request
      in Call(Fs.Read, call, (file, count))
        if child.resource(file).same_resource(mine)
          case backing.read(count)
          in Ok(bytes)
            sizes.push(bytes.len())
            child.answer(call, Ok(bytes))
          in Err(error)
            child.answer(call, Err(error))
          end
        else
          child.dispatch(request)
        end
      in Call(Fs.Close, call, (file,))
        if child.resource(file).same_resource(mine)
          child.answer(call, Ok(()))
        else
          child.dispatch(request)
        end
      in _
        child.dispatch(request)
      end
    in Done(value)
      return value
    in Fault(_)
      return "the child faulted"
    end
  end
end

case sys.fs.open(Path("message.txt", PathStyle.Posix), ReadOnly)
in Ok(backing)
  child = sys.vm.Vm().activate_or_fault(read_twice, args: ())
  case child.drive()
  in Asked(request)
    case request
    in Call(Fs.Open, call, (_, _))
      mine = child.serve_file(call)
      sizes: [Int] = []
      text = tee(child, mine, backing, sizes)
      backing.close()
      "the child read #{sizes.len()} times and saw #{text}"
    in _ then "the child asked for something else first"
    end
  in Done(_)  then "the child finished before it opened a file"
  in Fault(_) then "the child faulted before it opened a file"
  end
in Err(error) then display(error)
end
