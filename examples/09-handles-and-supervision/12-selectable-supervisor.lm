# Stop a running child through the supervisor mailbox.
#
# The child does not yield by itself. `drive_wait` gives its execution
# to the scheduler for one quantum at a time.
#
# The supervisor also waits for mailbox commands. The scheduler can run
# the controller between child quanta.

enum Command
  Stop
end

def untrusted_work(): Int
  loop do
    ()
  end
  0
end

class Supervisor < Proc[Command]
  def on_spawn(self): String with Proc, Vm, Wait
    child = sys.vm.Vm().from_fn(untrusted_work, args: ())

    loop do
      select
      in child.drive_wait() -> event
        # A real supervisor can inspect, answer, or reject each request.
        case event
        in Asked(request) then child.dispatch(request)
        in Done(_)
          return "the child finished"
        in Fault(_)
          return "the child faulted"
        end
      in self.receive_wait() -> received
        case received
        in Msg(Stop)
          return "the supervisor stopped the child"
        in Closed
          return "the command mailbox closed"
        end
      end
    end
    "unreachable"
  end
end

# The birth grant carries the declared row of `on_spawn`, so the
# supervisor starts with `Proc`, `Vm`, and `Wait` already passed. This
# spawner charges that same row, so it passes nothing it does not hold.
supervisor = Supervisor.spawn()

# The child never stops by itself, and the mailbox is empty, so the
# supervisor is parked in its select when this command arrives.
supervisor.send(Stop)

case supervisor.done()
in Done(message) then message
in Fault(fault)  then fault.code()
end
