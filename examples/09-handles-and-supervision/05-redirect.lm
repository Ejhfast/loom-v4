# Redirect: give the child a file that the supervisor chose.
#
# The supervisor opens the file itself. It answers the child's `Fs.Open`
# with that handle. The child receives an alias of one resource entry.
# The child cannot see that its path was ignored.
#
# Both aliases name one entry. The child's close therefore closes the
# supervisor's handle too.

def read_config(): String with Fs.Open, Fs.Read, Fs.Close
  case sys.fs.open("config.txt", ReadOnly)
  in Ok(file)
    text = case file.read(1024)
    in Ok(bytes)  then bytes.text()
    in Err(error) then error.message()
    end
    file.close()
    text
  in Err(error) then error.message()
  end
end

def redirect(child: Vm[String], approved: FileHandle): String with Vm
  loop do
    case child.drive()
    in Asked(request)
      case request.as_call(Fs.Open)
      in Some(call)
        child.answer(call, Ok(approved))
      in None
        child.dispatch(request)
      end
    in Done(value)
      return value
    in Fault(_)
      return "the child faulted"
    end
  end
  "the supervisor stopped"
end

case sys.fs.open("message.txt", ReadOnly)
in Ok(approved)
  child = sys.vm.Vm().from_fn(read_config, args: ())
  # Reads and closes on the shared entry reach the host.
  child.table().pass(Fs.Read, Fs.Close)
  text = redirect(child, approved)

  # The child closed the shared entry, so this alias is closed too.
  case approved.read(1)
  in Err(Closed) then "{text} (the shared entry is closed)"
  in Err(error)  then error.message()
  in Ok(_)       then "{text} (the entry is still open)"
  end
in Err(error) then error.message()
end
