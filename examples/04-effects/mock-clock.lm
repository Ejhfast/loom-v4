# Automatic run with a mocked Clock.Now: no manual driving, no real
# clock access.

def run_mocked(): Int with Vm
  vm = sys.vm.Vm().activate_or_fault(do || with Clock.Now
    sys.clock.now() + 1
  end, args: ())
  vm.table().mock(Clock.Now, do ||: Int 122 end)
  case vm.run()
  in Done(v)  then v
  in Fault(_) then 0 - 1
  end
end

run_mocked()
