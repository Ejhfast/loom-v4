# Manual driving: the holder intercepts every perform before policy,
# captures prints, mocks the clock, and dispatches the rest.

def drive_loop(vm: Run[Int], mut captured: [String]): ([String], Int) with Vm
  loop do
    case vm.drive()
    in Asked(q)
      case q
      in Call(Io.Write, call, (bytes,))
        captured.push(bytes.utf8().expect("the output is UTF-8"))
        vm.answer(call, Ok(bytes.len()))
      in Call(Clock.Now, call, ())
        vm.answer(call, 123)
      in _
        vm.dispatch(q)
      end
    in Done(value)
      return (captured.freeze(), value)
    in Fault(_)
      return (captured.freeze(), -1)
    end
  end
end

vm = sys.vm.Vm().activate_or_fault(do || with Io.Write, Clock.Now
  print("tick\n")
  sys.clock.now()
end, args: ())

captured: [String] = []
drive_loop(vm, captured)
