# Manual driving: the holder intercepts every perform before policy,
# captures prints, mocks the clock, and dispatches the rest.

def drive_loop(vm: Vm[Int], mut captured: [String]): ([String], Int) with Vm
  loop do
    case vm.drive()
    in Asked(q)
      case q
      in Call(Io.Print, call, (text,))
        captured.push(text)
        vm.answer(call, ())
      in Call(Clock.Now, call, ())
        vm.answer(call, 123)
      in _
        vm.dispatch(q)
      end
    in Done(value)
      return (captured.freeze(), value)
    in Fault(_)
      return (captured.freeze(), 0 - 1)
    end
  end
  (captured.freeze(), 0 - 1)
end

vm = sys.vm.Vm().from_fn(do || with Io.Print, Clock.Now
  sys.io.print("tick\n")
  sys.clock.now()
end, args: ())

captured: [String] = []
drive_loop(vm, captured)
