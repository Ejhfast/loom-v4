# The `use` alias form: `use` binds a short name to a fixed `sys`
# path. The alias grants nothing; the row and the policy still
# decide.

use sys.io.print
use sys.vm

def greet(name: String) with Io.Print
  print("Hello {name}!\n")
end

def run_child(): Int with Vm
  m = vm.Vm().activate_or_fault({ || 40 + 2 }, args: ())
  case m.run()
  in Done(v) then v
  in Fault(_) then panic("the greeting program faulted")
  end
end

greet("Ada")
run_child()
