# The `use` alias form: `use` binds a short name to a fixed `sys`
# path. The alias grants nothing; the row and the policy still
# decide.

use sys.io.write
use sys.vm

def greet(name: String) with Io.Write
  write("Hello #{name}!\n".bytes()).expect("the output writes")
end

def run_child(): Int with Vm
  m = vm.Vm().activate_or_fault({ || 40 + 2 }, args: ())
  case m.run()
  in Ok(v) then v
  in Err(_) then panic("the greeting program faulted")
  end
end

greet("Ada")
run_child()
