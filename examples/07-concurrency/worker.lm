# One proc uses a typed mailbox.
#
# The worker receives one message, doubles it, and returns the result.
# The spawner sends one message and waits for the terminal result. One
# request and one reply need no close.

enum Work
  Double(value: Int)
end

class Worker < Proc[Work]
  def on_spawn(self): Int with Proc
    case self.receive()
    in Msg(Double(n)) then n * 2
    in Closed         then 0
    end
  end
end

h = Worker.spawn()
h.send(Double(21))
h.done()
