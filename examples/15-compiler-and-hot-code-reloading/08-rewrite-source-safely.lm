# Change one token of your own code, and leave every other byte.
#
# Run with `--allow Compiler,Vm`.
#
# `codeof` hands back the syntax the compiler retained for a named
# definition. That tree is lossless: it holds the comments, the blank
# lines, and the exact spacing of the source, not only the parts a
# compiler needs.
#
# An edit rebuilds only the nodes between the change and the root.
# `with_children` takes the children it is given, so every child off
# that path travels by reference and cannot be altered. That is what
# makes an automatic edit safe to run over source a person owns.
#
# Retention is per definition, and the tree it returns is a flat run
# of tokens and trivia. So the number below is a direct child, and a
# comment written above `def` is not part of what comes back.

def limit(): Int
  # The service refuses more than this.

  ceiling    =    10

  ceiling
end

# The child index of the first token whose text matches, or -1.
def index_of(node: SyntaxElement, text: String): Int
  children = node.children()
  index = 0
  while index < children.len()
    if children.at(index).text() == text
      return index
    end
    index = index + 1
  end
  -1
end

# Rebuild one node. `parent` keeps every other child untouched.
def replace_child(parent: SyntaxNode, at: Int, child: SyntaxElement): SyntaxNode
  children = parent.children()
  children.set(at, child)
  parent.with_children(children)
end

def run_it(image: Vm, f: FunctionBinding[(), Int]): Result[Int, String] with Vm
  run = image.activate(f, args: ()).map_error() { |e: CodeError| e.message }?
  case run.run()
  in Done(value) then Ok(value)
  in Fault(_) then Err("the definition faulted")
  end
end

def go(): Result[(Bool, Int, Int), String] with Compiler, Vm
  original = case codeof(limit).source()
  in Some(source) then source.syntax
  in None then return Err("the definition kept no syntax")
  end

  # Retained definition syntax is a flat run of tokens and trivia, so
  # the number is a direct child.
  number_at = index_of(original, "10")
  if number_at < 0
    return Err("the number is not a child of the definition")
  end
  builder = SyntaxBuilder()
  edited = replace_child(original as SyntaxNode, number_at, builder.integer("25"))

  # Everything except the number is byte for byte what it was.
  expected = "def limit(): Int\n" +
    "  # The service refuses more than this.\n" +
    "\n" +
    "  ceiling    =    25\n" +
    "\n" +
    "  ceiling\nend"
  exact = edited.text().to_string() == expected

  # The rewritten tree is not trusted because it came from a tree. It
  # goes through the compiler like any other source.
  spec = codeof(limit).definition()
  known = List[(String, DefinitionSpec)]()
  known.push(("limit", spec))
  env = CompileEnv(List[VerifiedModule](), List[(String, String)](), known)
  options = CompileOptions(
    is_main: false,
    dynamic_result: false,
    late_definitions: false,
    late_functions: List[String](),
    late_classes: List[String]()
  )
  artifact = sys.compiler.compile_syntax(
    spec.module_name,
    "limit-revision.lm",
    edited,
    env,
    options
  ).map_error() { |e: CompileErrors| e.message }?
  module = artifact.verify().map_error() { |e: CodeError| e.message }?
  code = module.function_code[(), Int]("limit").map_error() {
    |e: CodeError| e.message
  }?

  image = sys.vm.Vm()
  first = image.install(codeof(limit)).map_error() { |e: CodeError| e.message }?
  before = run_it(image, first)?
  revision = image.install(code).map_error() { |e: CodeError| e.message }?
  image.replace(first, revision).map_error() { |e: CodeError| e.message }?
  after = run_it(image, first)?
  Ok((exact, before, after))
end

# The edit landed on the one token, and the rewritten definition
# replaced the original it was read from.
go()
