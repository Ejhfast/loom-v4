# An upgrade never changes a call that already started.
#
# Run with `--allow Vm,Io.ReadBytes`.
#
# Example 06 replaces code between requests. This one replaces code
# during a request, which is the harder case.
#
# `convert` asks the holder for today's factor in the middle of its
# own body. The holder answers that question and replaces the slot in
# the same turn. At that moment one `convert` frame is open.
#
# A frame pins the exact version that created it. So the open call
# finishes with the old rule, and the next call reads the new target.
# No request runs half of one release and half of another.

def factor(): Int with Io.ReadBytes
  bytes = sys.io.read_bytes(1).expect("the factor reads")
  text = case bytes.utf8()
  in Ok(value) then value
  in Err(_) then "1"
  end
  case text.parse_int(10)
  in Ok(value) then value
  in Err(_) then 1
  end
end

# The rule in service, and its replacement. Both suspend part way,
# so a replacement can land while one of their frames is open.
def convert(amount: Int): Int with Io.ReadBytes
  amount * factor()
end

def with_fee(amount: Int): Int with Io.ReadBytes
  amount * factor() + 1000
end

# Two conversions in order. The first is still open when the holder
# moves the slot.
def report(): [Int] with Io.ReadBytes
  out: [Int] = []
  out.push(convert(10))
  out.push(convert(10))
  out
end

# Answer every question with the same factor. Replace on the first
# question only, while the first `convert` frame is open.
def drive(
  image: Vm,
  run: Run[[Int]],
  original: FunctionBinding[(Int) -> Int with Io.ReadBytes],
  upgrade: FunctionBinding[(Int) -> Int with Io.ReadBytes]
): Result[[Int], String] with Vm
  upgraded = false
  loop do
    case run.drive()
    in Asked(question)
      case question
      in Call(Io.ReadBytes, call, (_count,))
        if not upgraded
          image.replace(original, upgrade).map_error() {
            |e: CodeError| e.message
          }?
          upgraded = true
        end
        run.answer(call, Ok(b"3"))
      in _
        run.dispatch(question)
      end
    in Done(values)
      return Ok(values)
    in Fault(_)
      return Err("the report faulted")
    end
  end
end

def show_boundary(): Result[[Int], String] with Vm, Io.ReadBytes
  image = sys.vm.Vm()
  image.install(factor).map_error() { |e: CodeError| e.message }?
  original = image.install(convert).map_error() { |e: CodeError| e.message }?
  upgrade = image.install(with_fee).map_error() { |e: CodeError| e.message }?
  entry = image.install(report).map_error() { |e: CodeError| e.message }?
  run = image.activate(entry, args: ()).map_error() { |e: CodeError| e.message }?
  run.table().pass(Io.ReadBytes)
  drive(image, run, original, upgrade)
end

# The open call answers 10 * 3. The next call answers 10 * 3 + 1000.
show_boundary()
