# Replace the code of a running server, and keep it running.
#
# Run with `--allow Compiler,Vm`. The server never reaches the host.
#
# The server is a run inside a VM that the holder owns. It reads one
# order at a time and answers with a price. The price comes from
# `price`, a late-bound function that lives in a VM slot.
#
# Partway through the orders, the holder installs a second module and
# points the slot at the new `price`. The server does not stop, and
# it does not lose the prices it already collected. Later orders use
# the new rule.
#
# The holder replaces the slot while the run waits for its next
# order. A stopped run is a safe replacement point, so no frame of
# the server is inside `price` at that moment.

# Join source lines, so an embedded program reads like a program.
def source(lines: [String]): String
  text = ""
  for line in lines
    text = text + line + "\n"
  end
  text
end

# Both releases make `price` late-bound, so it gets a VM slot.
def build(name: String, text: String): Result[VerifiedModule, CodeError] with Compiler
  names = List[String]()
  names.push("price")
  env = CompileEnv(
    List[VerifiedModule](),
    List[(String, String)](),
    List[(String, DefinitionSpec)]()
  )
  options = CompileOptions(
    is_main: true,
    dynamic_result: false,
    late_definitions: false,
    late_functions: names,
    late_classes: List[String]()
  )
  artifact = case sys.compiler.compile(name, name, text, env, options)
  in Ok(value) then value
  in Err(problem) then return Err(CodeError(problem.message))
  end
  artifact.verify()
end

# Release 1: the price rule, and the server loop that calls it. The
# server reads orders until the holder reports the end of the input.
def first_release(): String
  source([
    "def price(amount: Int): Int",
    "  amount * 2",
    "end",
    "def serve(): [Int] with Io.ReadLine",
    "  prices: [Int] = []",
    "  loop do",
    "    line = case sys.io.read_line()",
    "    in Ok(Some(text)) then text",
    "    in _ then \"stop\"",
    "    end",
    "    if line == \"stop\"",
    "      return prices.freeze()",
    "    end",
    "    amount = case line.parse_int(10)",
    "    in Ok(value) then value",
    "    in Err(_) then 0",
    "    end",
    "    prices.push(price(amount))",
    "  end",
    "end",
    "serve()"
  ])
end

# Release 2 adds a ten unit handling charge. The signature does not
# change, so the new function matches the slot contract.
def second_release(): String
  source([
    "def price(amount: Int): Int",
    "  amount * 2 + 10",
    "end",
    "price(0)"
  ])
end

# One planned upgrade: which slot to move, what to move it to, and
# how many orders to serve before the move.
final class Upgrade
  slot: Slot
  target: FunctionDef[(Int,), Int]
  after: Int
  orders: [String]

  def init(
    mut self,
    slot: Slot,
    target: FunctionDef[(Int,), Int],
    after: Int,
    orders: [String]
  )
    self.slot = slot
    self.target = target
    self.after = after
    self.orders = orders
  end

  # Answer each order, and replace the price rule at the planned
  # point. Report every price the server produced.
  def drive(self, image: Vm, server: Run[[Int]]): Result[[Int], CodeError] with Vm
    served = 0
    loop do
      case server.drive()
      in Asked(question)
        case question
        in Call(Io.ReadLine, call, ())
          if served == self.after
            image.replace(self.slot, self.target)?
          end
          if served >= self.orders.len()
            server.answer(call, Ok(None))
          else
            server.answer(call, Ok(Some(self.orders.at(served))))
            served = served + 1
          end
        in _
          server.dispatch(question)
        end
      in Done(prices)
        return Ok(prices)
      in Fault(_)
        return Err(CodeError("the server faulted"))
      end
    end
  end
end

def run_upgrade(): Result[[Int], CodeError] with Compiler, Vm
  released = build("shop", first_release())?
  patched = build("patch", second_release())?
  image = sys.vm.Vm()
  shop = image.install(released)?
  patch = image.install(patched)?

  # The slot carries the name the server compiled against. The new
  # target is an ordinary immutable definition in the second module.
  slot = shop.slot_for(shop.slot_spec("price")?)?
  target = patch.function[(Int,), Int]("price")?

  entry = shop.entry[(), [Int]]()?
  server = image.activate(entry, args: ())?
  orders: [String] = ["10", "25", "30", "40"]
  Upgrade(slot, target, 2, orders).drive(image, server)
end

# Orders one and two use the old rule. Orders three and four use the
# new one. One server handled all four.
run_upgrade()
