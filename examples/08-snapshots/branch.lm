# Branching execution: one snapshot, two independent worlds.
#
# The program steps a machine once, captures its world, and restores
# the capture twice. Each restore is a complete independent world, so
# both branches finish the same computation on their own state.

def restore_run(snap: RunSnapshot[Int]): Int with Vm
  case sys.vm.Vm().restore(snap)
  in Ok(restored)
    case restored.run()
    in Ok(value) then value
    in Err(_)    then panic("the restored run faulted")
    end
  in Err(_) then panic("the snapshot restore failed")
  end
end

vm = sys.vm.Vm().activate_or_fault(do ||: Int
  20 + 22
end, args: ())
vm.step()
case vm.snapshot()
in Ok(snap) then (restore_run(snap), restore_run(snap))
in Err(_)   then (-3, -3)
end
