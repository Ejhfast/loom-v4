# Wait until a child closes its transient file.

def open_then_close(): String with Fs.Open, Fs.Close
  case sys.fs.open("message.txt", ReadOnly)
  in Ok(file)
    case file.close()
    in Ok(_)      then "the child closed its file"
    in Err(error) then error.message()
    end
  in Err(error) then error.message()
  end
end

def dispatch_open(vm: Vm[String]): Bool with Vm
  case vm.drive()
  in Asked(request)
    case request.as_call(Fs.Open)
    in Some(_)
      vm.dispatch(request)
      true
    in None
      vm.dispatch(request)
      false
    end
  in Done(_)  then false
  in Fault(_) then false
  end
end

def demonstrate_snapshot_wait(): String with Vm, Fs.Open, Fs.Close
  program = do ||: String with Fs.Open, Fs.Close
    open_then_close()
  end
  child = sys.vm.Vm().from_object(program, args: ())
  child.table().pass(Fs.Open)
  child.table().pass(Fs.Close)

  if not dispatch_open(child)
    return "the child did not request a file"
  end
  if child.snapshot_wait(0).is_ok()
    return "zero fuel did not report the live file"
  end
  if child.snapshot_wait(1000).is_err()
    return "the child did not close its file before the fuel ended"
  end
  if child.handles().len() != 0
    return "the closed file remained live"
  end

  case child.run()
  in Done(message) then message
  in Fault(_)      then "the child faulted"
  end
end

demonstrate_snapshot_wait()
