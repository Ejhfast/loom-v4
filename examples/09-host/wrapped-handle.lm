# Give a sandboxed parser one configuration file that its parent approved.

def read_virtual_config(): String with Fs.Open, Fs.Read, Fs.Close
  case sys.fs.open("virtual.txt", ReadOnly)
  in Ok(file)
    text = case file.read(1024)
    in Ok(bytes)  then bytes.text()
    in Err(error)
      return error.message()
    end
    case file.close()
    in Ok(_)      then text
    in Err(error) then error.message()
    end
  in Err(error) then error.message()
  end
end

def supply_approved_file(vm: Vm[String], file: FileHandle): Bool with Vm
  # `drive` exposes the child's next request before policy dispatch.
  case vm.drive()
  in Asked(request)
    case request.as_call(Fs.Open)
    in Some(call)
      # `answer` gives the child an alias of the existing handle.
      vm.answer(call, Ok(file))
      true
    in None then false
    end
  in Done(_)  then false
  in Fault(_) then false
  end
end

def demonstrate_approved_file(): String with Vm, Fs.Open, Fs.Read, Fs.Close
  case sys.fs.open("message.txt", ReadOnly)
  in Ok(parent_file)
    # The parser sees only its virtual configuration path.
    child = sys.vm.Vm().from_object(read_virtual_config, args: ())

    # Later read and close requests can reach the handle's host.
    child.table().pass(Fs.Read)
    child.table().pass(Fs.Close)

    if not supply_approved_file(child, parent_file)
      return "the child did not request a file"
    end

    text = case child.run()
    in Done(value) then value
    in Fault(_)
      return "the child faulted"
    end

    # Closing either alias closes their shared resource entry.
    case parent_file.read(1)
    in Err(Closed) then text
    in Err(error)  then error.message()
    in Ok(_)       then "the child did not close the shared file"
    end
  in Err(error) then error.message()
  end
end

demonstrate_approved_file()
