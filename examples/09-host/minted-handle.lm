# Back a child's ordinary file operations with parent-owned bytes.

def read_memory_file(): String with Fs.Open, Fs.Read, Fs.Close
  case sys.fs.open("memory.txt", ReadOnly)
  in Ok(file)
    text = case file.read(1024)
    in Ok(bytes) then bytes.text()
    in Err(error)
      return error.message()
    end
    case file.close()
    in Ok(_)      then text
    in Err(error) then error.message()
    end
  in Err(error) then error.message()
  end
end

def serve_memory_request(
  child: Vm[String],
  request: Request,
  control: ResourceHandle,
  contents: Bytes
): Bool with Vm
  case request.as_call(Fs.Read)
  in Some(call)
    args = call.args()

    # `resource` gives the parent control for this child handle.
    requested = child.resource(args[0])
    if not requested.same_resource(control)
      child.answer(call, Err(Failed("the file does not belong to this driver")))
    elsif args[1] < contents.len()
      child.answer(call, Err(Failed("the read limit is too small")))
    else
      child.answer(call, Ok(contents))
    end
    true
  in None
    case request.as_call(Fs.Close)
    in Some(call)
      args = call.args()
      requested = child.resource(args[0])
      if requested.same_resource(control)
        child.answer(call, Ok(()))
      else
        child.answer(call, Err(Failed("the file does not belong to this driver")))
      end
      true
    in None then false
    end
  end
end

def drive_memory_file(
  child: Vm[String],
  control: ResourceHandle,
  contents: Bytes
): String with Vm
  loop do
    # Each `drive` exposes one request before policy dispatch.
    case child.drive()
    in Asked(request)
      if not serve_memory_request(child, request, control, contents)
        # `dispatch` applies policy to requests outside this driver.
        child.dispatch(request)
      end
    in Done(text)
      return text
    in Fault(_)
      return "the child faulted"
    end
  end
  "the driver stopped"
end

def demonstrate_memory_file(): String with Vm
  child = sys.vm.Vm().from_object(read_memory_file, args: ())

  # The first request opens the parent's in-memory file.
  case child.drive()
  in Asked(request)
    case request.as_call(Fs.Open)
    in Some(call)
      # `mint_file` answers the open and routes later operations here.
      control = child.mint_file(call)
      text = drive_memory_file(child, control, Bytes("parent memory"))
      if control.is_open()
        "the child did not close the memory file"
      else
        text
      end
    in None then "the child did not request a file"
    end
  in Done(_)  then "the child completed before opening a file"
  in Fault(_) then "the child faulted before opening a file"
  end
end

demonstrate_memory_file()
