# Close a child file before a snapshot, then restore the child.

def observe_forced_close(): String with Fs.Open, Fs.Close, Io.Print
  case sys.fs.open("message.txt", ReadOnly)
  in Ok(file)
    sys.io.print("the file is open")
    case file.close()
    in Err(Closed) then "the restored child observed a closed file"
    in Err(error)  then error.message()
    in Ok(_)       then "the file remained open"
    end
  in Err(error) then error.message()
  end
end

def dispatch_open(vm: Vm[String]): Bool with Vm
  case vm.drive()
  in Asked(request)
    case request.as_call(Fs.Open)
    in Some(_)
      vm.dispatch(request)
      true
    in None
      vm.dispatch(request)
      false
    end
  in Done(_)  then false
  in Fault(_) then false
  end
end

def stop_at_print(vm: Vm[String]): Bool with Vm
  case vm.drive()
  in Asked(request) then request.as_call(Io.Print).is_some()
  in Done(_)        then false
  in Fault(_)       then false
  end
end

def resume_snapshot(snapshot: Snapshot[String]): String with Vm, Fs.Close
  case sys.vm.Vm().restore(snapshot)
  in Ok(restored)
    restored.table().pass(Fs.Close)
    case restored.drive()
    in Asked(request)
      case request.as_call(Io.Print)
      in Some(call) then restored.answer(call, ())
      in None
        restored.dispatch(request)
        return "the restored child requested an unexpected effect"
      end
    in Done(_)
      return "the restored child completed too early"
    in Fault(_)
      return "the restored child faulted"
    end
    case restored.run()
    in Done(message) then message
    in Fault(_)      then "the restored child faulted"
    end
  in Err(_) then "the snapshot did not restore"
  end
end

def demonstrate_managed_snapshot(): String with Vm, Fs.Open, Fs.Close
  program = do ||: String with Fs.Open, Fs.Close, Io.Print
    observe_forced_close()
  end
  child = sys.vm.Vm().from_object(program, args: ())
  child.table().pass(Fs.Open)

  if not dispatch_open(child)
    return "the child did not request a file"
  end
  if not stop_at_print(child)
    return "the child did not reach its pause point"
  end
  if child.snapshot().is_ok()
    return "a live file entered a snapshot"
  end

  controls = child.handles()
  if controls.len() != 1
    return "the holder did not find one live file"
  end
  if not controls.at(0).close()
    return "the holder did not close the file"
  end

  case child.snapshot()
  in Ok(snapshot) then resume_snapshot(snapshot)
  in Err(_)       then "the closed file blocked the snapshot"
  end
end

demonstrate_managed_snapshot()
