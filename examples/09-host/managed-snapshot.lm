# Force-close an application's transient file before a snapshot.

def read_and_close(file: FileHandle): String with Fs.Read, Fs.Close
  text = case file.read(1024)
  in Ok(bytes) then bytes.text()
  in Err(error)
    return error.message()
  end
  case file.close()
  in Ok(_)      then text
  in Err(error) then error.message()
  end
end

def checkpointable_reader(): String with Fs.Open, Fs.Read, Fs.Close
  case sys.fs.open("message.txt", ReadOnly)
  in Ok(file)
    case file.read(1024)
    in Ok(bytes)
      file.close()
      bytes.text()
    in Err(Closed)
      # The restored application recovers from forced closure.
      case sys.fs.open("message.txt", ReadOnly)
      in Ok(reopened) then "reopened {read_and_close(reopened)}"
      in Err(error)   then error.message()
      end
    in Err(error) then error.message()
    end
  in Err(error) then error.message()
  end
end

def start_reader(child: Vm[String]): Bool with Vm
  # `drive` exposes the open request before policy dispatch.
  case child.drive()
  in Asked(request)
    case request.as_call(Fs.Open)
    in Some(_)
      # `dispatch` applies the filesystem policy and completes the open.
      child.dispatch(request)
      true
    in None then false
    end
  in Done(_)  then false
  in Fault(_) then false
  end
end

def resume_reader(snapshot: Snapshot[String]): String with Vm, Fs
  case sys.vm.Vm().restore(snapshot)
  in Ok(restored)
    # Restore creates a new default-deny policy table.
    restored.table().pass(Fs)
    case restored.run()
    in Done(message) then message
    in Fault(_)      then "the restored application faulted"
    end
  in Err(_) then "the snapshot did not restore"
  end
end

def demonstrate_managed_snapshot(): String with Vm, Fs
  child = sys.vm.Vm().from_object(checkpointable_reader, args: ())

  # The supervisor permits normal filesystem requests.
  child.table().pass(Fs)
  if not start_reader(child)
    return "the application did not open its input file"
  end
  if child.snapshot().is_ok()
    return "a live file entered the snapshot"
  end

  # `handles` returns controls for all live child resources.
  controls = child.handles()
  if controls.len() != 1
    return "the supervisor did not find one live file"
  end
  if not controls.at(0).close()
    return "the supervisor did not close the file"
  end

  # The closed handle stays as ordinary child state.
  case child.snapshot()
  in Ok(snapshot) then resume_reader(snapshot)
  in Err(_)       then "the closed file blocked the snapshot"
  end
end

demonstrate_managed_snapshot()
