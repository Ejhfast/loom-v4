# Run one complete multishot search across parallel workers.
#
# Run with `--allow Vm,Wait`.
#
# `place` runs inside each reified world. It asks the driver for one
# column at each row.
#
# The driver copies each pending world for every possible answer.
# `branch_answer` answers only the copy. The original world takes the
# final answer.
#
# `drive_wait` lets the scheduler execute all current worlds in
# parallel. `sys.wait.any` returns the next world boundary.
#
# World copies and dynamic wait sets have significant fixed costs.
# Each `any` call rebuilds and rearms the complete frontier.
# This example shows the semantics. It is not a fast small-board solver.
# Direct recursive search runs this small board faster on one core.
# Parallel multishot search helps when each world performs enough work
# to repay its copy and coordination costs.

def place(n: Int): Int with Choose
  columns = List[Int]()
  row = 0

  while row < n
    column = sys.choose.pick(n)
    older = 0

    while older < columns.len()
      seen = columns.at(older)
      gap = row - older

      if seen == column or column - seen == gap or seen - column == gap
        return 0
      end

      older = older + 1
    end

    columns.push(column)
    row = row + 1
  end

  1
end

def parallel_solutions(n: Int): Int with Vm, Wait
  runs = List[Run[Int]]()
  runs.push(sys.vm.Vm().activate_or_fault(place, args: (n,)))
  total = 0

  while runs.len() != 0
    waits = List[Wait[DriveEvent[Int]]]()

    for run in runs
      waits.push(run.drive_wait())
    end

    case sys.wait.any(waits)
    in (index, event)
      run = runs.remove(index)

      case event
      in Done(value)
        total = total + value
      in Fault(fault)
        raise(fault)
      in Asked(request)
        case request
        in Call(Choose.Pick, call, (count,))
          if count <= 0
            panic("the choice count must be positive")
          end

          choice = 0
          while choice + 1 < count
            case run.branch_answer(call, choice)
            in Ok(branch)
              runs.push(branch)
            in Err(error)
              panic(display(error))
            end
            choice = choice + 1
          end

          run.answer(call, choice)
          runs.push(run)
        in _
          panic("the search asked for an unexpected effect")
        end
      end
    end
  end

  total
end

# Five queens has ten solutions.
parallel_solutions(5)
