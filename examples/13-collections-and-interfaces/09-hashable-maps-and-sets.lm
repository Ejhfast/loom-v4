# Use one value type in a map and a set.
#
# This example needs no grant.
# `Hashable` supplies equality and one stable semantic hash.
# A frozen class creates stable keys after initialization.

frozen class AccountId implements Hashable
  region: Int
  number: Int

  def init(mut self, region: Int, number: Int)
    self.region = region
    self.number = number
  end

  def __eq__(self, other: AccountId): Bool
    self.region == other.region and self.number == other.number
  end

  def __hash__(self): Int
    hash_combine(hash_combine(17, self.region), self.number)
  end
end

first = AccountId(4, 7)
same = AccountId(4, 7)

records: Map[AccountId, String] = {first: "open"}
previous = records.put(same, "closed")

active = Set[AccountId]()
added = active.add(first)
duplicate = active.add(same)

(
  records.len(),
  records.at(first),
  previous,
  active.len(),
  active.has(same),
  added,
  duplicate
)
