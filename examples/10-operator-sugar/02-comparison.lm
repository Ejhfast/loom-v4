# Comparison and equality hooks.
#
# `<`, `<=`, `>`, and `>=` read `__lt__`, `__le__`, `__gt__`, and
# `__ge__`. `==` and `!=` read `__eq__` and `__ne__`.
#
# A class without `__eq__` keeps the rule of specification 6.4: two
# instances compare by reference. `Version` declares `__eq__`, so it
# compares by value instead.
#
# `__eq__` governs `==` alone. `Map` keys, `digest`, and `deep_equal`
# use structural identity and never call the hook, so a class that
# makes `==` disagree with its structure gets a map lookup that misses.
# `Version` keeps them in step: equal fields mean equal values.

final class Version
  major: Int
  minor: Int

  def init(mut self, major: Int, minor: Int)
    self.major = major
    self.minor = minor
  end

  def __eq__(self, other: Version): Bool
    self.major == other.major and self.minor == other.minor
  end

  def __ne__(self, other: Version): Bool
    not (self == other)
  end

  def __lt__(self, other: Version): Bool
    if self.major == other.major
      self.minor < other.minor
    else
      self.major < other.major
    end
  end

  def __ge__(self, other: Version): Bool
    not (self < other)
  end
end

lines: [String] = []

# Two separate instances, equal fields. Without `__eq__` this reads
# false, because the values sit at different heap slots.
if Version(1, 4) == Version(1, 4)
  lines.push("equal by value")
end

if Version(1, 4) < Version(1, 10)
  lines.push("1.4 precedes 1.10")
end

if Version(2, 0) >= Version(1, 10)
  lines.push("2.0 is not older")
end

"{lines.at(0)}; {lines.at(1)}; {lines.at(2)}"
