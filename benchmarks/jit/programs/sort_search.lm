def quicksort(mut values: [Int], low: Int, high: Int)
  if low < high
    pivot = values[(low + high) / 2]
    i = low
    j = high
    while i <= j
      while values[i] < pivot
        i = i + 1
      end
      while values[j] > pivot
        j = j - 1
      end
      if i <= j
        tmp = values[i]
        values.set(i, values[j])
        values.set(j, tmp)
        i = i + 1
        j = j - 1
      end
    end
    quicksort(values, low, j)
    quicksort(values, i, high)
  end
end

def binary_search(values: [Int], target: Int): Bool
  low = 0
  high = values.len() - 1
  while low <= high
    mid = (low + high) / 2
    probe = values[mid]
    if probe == target
      return true
    end
    if probe < target
      low = mid + 1
    else
      high = mid - 1
    end
  end
  false
end

count = 30000
values = List[Int]()
values.reserve(count)
seed = 424242
i = 0
while i < count
  seed = (seed * 1103515245 + 12345) % 2147483648
  values.push(seed % 1000000)
  i = i + 1
end
quicksort(values, 0, count - 1)
found = 0
i = 0
seed = 777
while i < count
  seed = (seed * 1103515245 + 12345) % 2147483648
  if binary_search(values, seed % 1000000)
    found = found + 1
  end
  i = i + 1
end
(values[0], values[count - 1], found)
