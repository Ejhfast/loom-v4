def luma(r: Int, g: Int, b: Int): Int
  (r * 299 + g * 587 + b * 114) / 1000
end

def clamp8(value: Int): Int
  if value < 0 then
    0
  else
    if value > 255 then 255 else value end
  end
end

reds = List[Int]()
greens = List[Int]()
blues = List[Int]()
seed = 7
count = 0
while count < 65536
  seed = (seed * 1103515245 + 12345).bit_and(2147483647)
  reds.push(seed.bit_and(255))
  greens.push((seed / 256).bit_and(255))
  blues.push((seed / 65536).bit_and(255))
  count = count + 1
end

pass = 0
bright = 0
total = 0
while pass < 30
  i = 0
  while i < 65536
    l = clamp8(luma(reds[i], greens[i], blues[i]) + 16)
    if l > 128
      bright = bright + 1
    end
    total = (total + l).bit_and(268435455)
    i = i + 1
  end
  pass = pass + 1
end
(bright, total)
