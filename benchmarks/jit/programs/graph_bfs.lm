side = 100
count = side * side
adjacency = List[List[Int]]()
adjacency.reserve(count)
node = 0
while node < count
  row = node / side
  col = node % side
  edges = List[Int]()
  if row > 0
    edges.push(node - side)
  end
  if row < side - 1
    edges.push(node + side)
  end
  if col > 0
    edges.push(node - 1)
  end
  if col < side - 1
    edges.push(node + 1)
  end
  adjacency.push(edges)
  node = node + 1
end

total = 0
rep = 0
while rep < 10
  distance = List[Int]()
  distance.reserve(count)
  i = 0
  while i < count
    distance.push(0 - 1)
    i = i + 1
  end
  queue = List[Int]()
  queue.push(rep * 37 % count)
  distance.set(rep * 37 % count, 0)
  head = 0
  while head < queue.len()
    current = queue[head]
    head = head + 1
    for neighbor in adjacency[current]
      if distance[neighbor] < 0
        distance.set(neighbor, distance[current] + 1)
        queue.push(neighbor)
      end
    end
  end
  i = 0
  while i < count
    total = total + distance[i]
    i = i + 1
  end
  rep = rep + 1
end
total
