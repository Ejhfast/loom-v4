# Standard library: portable terminal byte helpers.

enum TermKey
  Text(value: String)
  Ctrl(value: Char)
  Alt(value: Char)
  Enter
  Tab
  Backspace
  Escape
  Up
  Down
  Left
  Right
  Home
  End
  PageUp
  PageDown
  Delete
  Unknown(value: Bytes)
end

enum KeyDecode
  Decoded(key: TermKey, consumed: Int)
  NeedMore
end

enum TermError implements Error
  InvalidPosition(message: String)

  def append_to(self, mut builder: StringBuilder)
    case self
    in InvalidPosition(message) then builder.append(message)
    end
  end
end

def clear_screen(): Bytes
  b"\x1b[2J"
end

def clear_line(): Bytes
  b"\x1b[2K"
end

def hide_cursor(): Bytes
  b"\x1b[?25l"
end

def show_cursor(): Bytes
  b"\x1b[?25h"
end

def reset_style(): Bytes
  b"\x1b[0m"
end

def cursor_to(column: Int, row: Int): Result[Bytes, TermError]
  if column < 1 or row < 1
    Err(TermError.InvalidPosition("terminal positions start at one"))
  else
    Ok("\x1b[#{row};#{column}H".bytes())
  end
end

def unknown_prefix(input: Bytes, count: Int): KeyDecode
  Decoded(TermKey.Unknown(input.slice(0, count).expect("the key prefix is valid")), count)
end

def _scalar_width(first: Int): Int
  if first < 128
    1
  elsif first >= 194 and first <= 223
    2
  elsif first >= 224 and first <= 239
    3
  elsif first >= 240 and first <= 244
    4
  else
    0
  end
end

def _incomplete_escape(input: Bytes, finish_escape: Bool): KeyDecode
  if finish_escape
    unknown_prefix(input, input.len())
  else
    KeyDecode.NeedMore
  end
end

def _decode_csi(input: Bytes, finish_escape: Bool): KeyDecode
  index = 2
  has_intermediate = false
  while index < input.len()
    byte = input.at(index)
    if byte >= 48 and byte <= 63
      if has_intermediate
        return unknown_prefix(input, index + 1)
      end
    elsif byte >= 32 and byte <= 47
      has_intermediate = true
    elsif byte >= 64 and byte <= 126
      count = index + 1
      if count == 3
        if byte == 65
          return Decoded(TermKey.Up, count)
        elsif byte == 66
          return Decoded(TermKey.Down, count)
        elsif byte == 67
          return Decoded(TermKey.Right, count)
        elsif byte == 68
          return Decoded(TermKey.Left, count)
        elsif byte == 72
          return Decoded(TermKey.Home, count)
        elsif byte == 70
          return Decoded(TermKey.End, count)
        end
      elsif count == 4 and input.at(3) == 126
        parameter = input.at(2)
        if parameter == 49
          return Decoded(TermKey.Home, count)
        elsif parameter == 51
          return Decoded(TermKey.Delete, count)
        elsif parameter == 52
          return Decoded(TermKey.End, count)
        elsif parameter == 53
          return Decoded(TermKey.PageUp, count)
        elsif parameter == 54
          return Decoded(TermKey.PageDown, count)
        end
      end
      return unknown_prefix(input, count)
    else
      return unknown_prefix(input, index + 1)
    end
    index = index + 1
  end
  _incomplete_escape(input, finish_escape)
end

def _decode_ss3(input: Bytes, finish_escape: Bool): KeyDecode
  if input.len() < 3
    return _incomplete_escape(input, finish_escape)
  end

  final_byte = input.at(2)
  if final_byte == 65
    Decoded(TermKey.Up, 3)
  elsif final_byte == 66
    Decoded(TermKey.Down, 3)
  elsif final_byte == 67
    Decoded(TermKey.Right, 3)
  elsif final_byte == 68
    Decoded(TermKey.Left, 3)
  elsif final_byte == 72
    Decoded(TermKey.Home, 3)
  elsif final_byte == 70
    Decoded(TermKey.End, 3)
  else
    unknown_prefix(input, 3)
  end
end

def _decode_alt(input: Bytes, finish_escape: Bool): KeyDecode
  first = input.at(1)
  width = _scalar_width(first)
  if width == 0
    return unknown_prefix(input, 2)
  elsif input.len() < width + 1
    return _incomplete_escape(input, finish_escape)
  end

  prefix = input.slice(1, width).expect("the alternate scalar prefix is valid")
  case prefix.utf8()
  in Ok(text)
    value = text.at(0).expect("the alternate key has one scalar")
    codepoint = value.codepoint()
    if codepoint >= 32 and (codepoint < 127 or codepoint > 159)
      Decoded(TermKey.Alt(value), width + 1)
    else
      unknown_prefix(input, width + 1)
    end
  in Err(_) then unknown_prefix(input, 2)
  end
end

# Decode the first key in one bounded input prefix.
# Set `finish_escape` after an escape timeout or at input completion.
def decode_key(input: Bytes, finish_escape: Bool): KeyDecode
  if input.is_empty()
    return NeedMore
  end

  first = input.at(0)
  if first == 10 or first == 13
    return Decoded(TermKey.Enter, 1)
  elsif first == 9
    return Decoded(TermKey.Tab, 1)
  elsif first == 8 or first == 127
    return Decoded(TermKey.Backspace, 1)
  elsif first >= 1 and first <= 26
    value = "abcdefghijklmnopqrstuvwxyz".at(first - 1).expect("the control key is valid")
    return Decoded(TermKey.Ctrl(value), 1)
  end

  if first == 27
    if input.len() == 1
      if finish_escape
        return Decoded(TermKey.Escape, 1)
      else
        return NeedMore
      end
    end

    second = input.at(1)
    if second == 91
      return _decode_csi(input, finish_escape)
    elsif second == 79
      return _decode_ss3(input, finish_escape)
    else
      return _decode_alt(input, finish_escape)
    end
  end

  scalar_bytes = _scalar_width(first)
  if scalar_bytes == 0
    return unknown_prefix(input, 1)
  end

  if input.len() < scalar_bytes
    if finish_escape
      return unknown_prefix(input, input.len())
    else
      return NeedMore
    end
  end

  prefix = input.slice(0, scalar_bytes).expect("the scalar prefix is valid")
  case prefix.utf8()
  in Ok(text) then Decoded(TermKey.Text(text), scalar_bytes)
  in Err(_)   then unknown_prefix(input, 1)
  end
end
