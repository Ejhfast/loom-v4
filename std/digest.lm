# Standard library: cryptographic digests and checksums.

const _WORD_MASK: Int = 4294967295

const _SHA256_CONSTANTS: Bytes = b"\x42\x8a\x2f\x98\x71\x37\x44\x91\xb5\xc0\xfb\xcf\xe9\xb5\xdb\xa5\x39\x56\xc2\x5b\x59\xf1\x11\xf1\x92\x3f\x82\xa4\xab\x1c\x5e\xd5\xd8\x07\xaa\x98\x12\x83\x5b\x01\x24\x31\x85\xbe\x55\x0c\x7d\xc3\x72\xbe\x5d\x74\x80\xde\xb1\xfe\x9b\xdc\x06\xa7\xc1\x9b\xf1\x74\xe4\x9b\x69\xc1\xef\xbe\x47\x86\x0f\xc1\x9d\xc6\x24\x0c\xa1\xcc\x2d\xe9\x2c\x6f\x4a\x74\x84\xaa\x5c\xb0\xa9\xdc\x76\xf9\x88\xda\x98\x3e\x51\x52\xa8\x31\xc6\x6d\xb0\x03\x27\xc8\xbf\x59\x7f\xc7\xc6\xe0\x0b\xf3\xd5\xa7\x91\x47\x06\xca\x63\x51\x14\x29\x29\x67\x27\xb7\x0a\x85\x2e\x1b\x21\x38\x4d\x2c\x6d\xfc\x53\x38\x0d\x13\x65\x0a\x73\x54\x76\x6a\x0a\xbb\x81\xc2\xc9\x2e\x92\x72\x2c\x85\xa2\xbf\xe8\xa1\xa8\x1a\x66\x4b\xc2\x4b\x8b\x70\xc7\x6c\x51\xa3\xd1\x92\xe8\x19\xd6\x99\x06\x24\xf4\x0e\x35\x85\x10\x6a\xa0\x70\x19\xa4\xc1\x16\x1e\x37\x6c\x08\x27\x48\x77\x4c\x34\xb0\xbc\xb5\x39\x1c\x0c\xb3\x4e\xd8\xaa\x4a\x5b\x9c\xca\x4f\x68\x2e\x6f\xf3\x74\x8f\x82\xee\x78\xa5\x63\x6f\x84\xc8\x78\x14\x8c\xc7\x02\x08\x90\xbe\xff\xfa\xa4\x50\x6c\xeb\xbe\xf9\xa3\xf7\xc6\x71\x78\xf2"

const _MD5_CONSTANTS: Bytes = b"\x78\xa4\x6a\xd7\x56\xb7\xc7\xe8\xdb\x70\x20\x24\xee\xce\xbd\xc1\xaf\x0f\x7c\xf5\x2a\xc6\x87\x47\x13\x46\x30\xa8\x01\x95\x46\xfd\xd8\x98\x80\x69\xaf\xf7\x44\x8b\xb1\x5b\xff\xff\xbe\xd7\x5c\x89\x22\x11\x90\x6b\x93\x71\x98\xfd\x8e\x43\x79\xa6\x21\x08\xb4\x49\x62\x25\x1e\xf6\x40\xb3\x40\xc0\x51\x5a\x5e\x26\xaa\xc7\xb6\xe9\x5d\x10\x2f\xd6\x53\x14\x44\x02\x81\xe6\xa1\xd8\xc8\xfb\xd3\xe7\xe6\xcd\xe1\x21\xd6\x07\x37\xc3\x87\x0d\xd5\xf4\xed\x14\x5a\x45\x05\xe9\xe3\xa9\xf8\xa3\xef\xfc\xd9\x02\x6f\x67\x8a\x4c\x2a\x8d\x42\x39\xfa\xff\x81\xf6\x71\x87\x22\x61\x9d\x6d\x0c\x38\xe5\xfd\x44\xea\xbe\xa4\xa9\xcf\xde\x4b\x60\x4b\xbb\xf6\x70\xbc\xbf\xbe\xc6\x7e\x9b\x28\xfa\x27\xa1\xea\x85\x30\xef\xd4\x05\x1d\x88\x04\x39\xd0\xd4\xd9\xe5\x99\xdb\xe6\xf8\x7c\xa2\x1f\x65\x56\xac\xc4\x44\x22\x29\xf4\x97\xff\x2a\x43\xa7\x23\x94\xab\x39\xa0\x93\xfc\xc3\x59\x5b\x65\x92\xcc\x0c\x8f\x7d\xf4\xef\xff\xd1\x5d\x84\x85\x4f\x7e\xa8\x6f\xe0\xe6\x2c\xfe\x14\x43\x01\xa3\xa1\x11\x08\x4e\x82\x7e\x53\xf7\x35\xf2\x3a\xbd\xbb\xd2\xd7\x2a\x91\xd3\x86\xeb"

const _MD5_SHIFTS: Bytes = b"\x07\x0c\x11\x16\x07\x0c\x11\x16\x07\x0c\x11\x16\x07\x0c\x11\x16\x05\x09\x0e\x14\x05\x09\x0e\x14\x05\x09\x0e\x14\x05\x09\x0e\x14\x04\x0b\x10\x17\x04\x0b\x10\x17\x04\x0b\x10\x17\x04\x0b\x10\x17\x06\x0a\x0f\x15\x06\x0a\x0f\x15\x06\x0a\x0f\x15\x06\x0a\x0f\x15"

const _CRC32_TABLE: Bytes = b"\x00\x00\x00\x00\x64\x10\xb7\x1d\xc8\x20\x6e\x3b\xac\x30\xd9\x26\x90\x41\xdc\x76\xf4\x51\x6b\x6b\x58\x61\xb2\x4d\x3c\x71\x05\x50\x20\x83\xb8\xed\x44\x93\x0f\xf0\xe8\xa3\xd6\xd6\x8c\xb3\x61\xcb\xb0\xc2\x64\x9b\xd4\xd2\xd3\x86\x78\xe2\x0a\xa0\x1c\xf2\xbd\xbd"

interface DigestState: Copyable
  type Output
  def update(mut self, bytes: Bytes): Self
  def finish(mut self): Self.Output
  def reset(mut self): Self
end

def _word_buffer(): List[Int]
  words = List[Int]()
  words.reserve(16)
  index = 0
  while index < 16
    words.push(0)
    index = index + 1
  end
  words
end

def _rotate_right_32(value: Int, amount: Int): Int
  repeated = value | (value << 32)
  repeated.rotate_right(amount) & _WORD_MASK
end

def _rotate_left_32(value: Int, amount: Int): Int
  repeated = value | (value << 32)
  repeated.rotate_left(amount) & _WORD_MASK
end

def _append_word_be(mut output: ByteBuffer, value: Int)
  output.append((value >>> 24) & 255)
  output.append((value >>> 16) & 255)
  output.append((value >>> 8) & 255)
  output.append(value & 255)
end

def _append_word_le(mut output: ByteBuffer, value: Int)
  output.append(value & 255)
  output.append((value >>> 8) & 255)
  output.append((value >>> 16) & 255)
  output.append((value >>> 24) & 255)
end

final class Sha256 implements DigestState
  type Output = Bytes

  h0: Int
  h1: Int
  h2: Int
  h3: Int
  h4: Int
  h5: Int
  h6: Int
  h7: Int
  byte_count: Int
  pending: ByteBuffer
  schedule: List[Int]

  def init(mut self)
    self.h0 = 0
    self.h1 = 0
    self.h2 = 0
    self.h3 = 0
    self.h4 = 0
    self.h5 = 0
    self.h6 = 0
    self.h7 = 0
    self.byte_count = 0
    self.pending = ByteBuffer()
    self.schedule = _word_buffer()
    self.reset()
  end

  def reset(mut self): Sha256
    self.h0 = 1779033703
    self.h1 = 3144134277
    self.h2 = 1013904242
    self.h3 = 2773480762
    self.h4 = 1359893119
    self.h5 = 2600822924
    self.h6 = 528734635
    self.h7 = 1541459225
    self.byte_count = 0
    self.pending.clear()
    self
  end

  def _copy_from(mut self, other: Sha256): Sha256
    self.h0 = other.h0
    self.h1 = other.h1
    self.h2 = other.h2
    self.h3 = other.h3
    self.h4 = other.h4
    self.h5 = other.h5
    self.h6 = other.h6
    self.h7 = other.h7
    self.byte_count = other.byte_count
    self.pending.clear()
    self.pending.extend(other.pending.build())
    self
  end

  def copy(self): Sha256
    result = Sha256()
    result._copy_from(self)
  end

  def _block(mut self, source: Bytes, offset: Int)
    schedule = self.schedule
    a = self.h0
    b = self.h1
    c = self.h2
    d = self.h3
    e = self.h4
    f = self.h5
    g = self.h6
    h = self.h7
    constants = _SHA256_CONSTANTS

    round = 0
    while round < 64
      word = if round < 16
        source.read_u32_be(offset + round * 4)
      else
        prior = schedule.at((round - 15) & 15)
        sigma0 = _rotate_right_32(prior, 7) ^
          _rotate_right_32(prior, 18) ^ (prior >>> 3)
        prior = schedule.at((round - 2) & 15)
        sigma1 = _rotate_right_32(prior, 17) ^
          _rotate_right_32(prior, 19) ^ (prior >>> 10)
        (schedule.at((round - 16) & 15) + sigma0 +
          schedule.at((round - 7) & 15) + sigma1) & _WORD_MASK
      end
      schedule.set(round & 15, word)

      sum1 = _rotate_right_32(e, 6) ^ _rotate_right_32(e, 11) ^
        _rotate_right_32(e, 25)
      choose = ((e & f) ^ ((~e) & g)) & _WORD_MASK
      constant = constants.read_u32_be(round * 4)
      temporary1 = (h + sum1 + choose + constant + word) & _WORD_MASK
      sum0 = _rotate_right_32(a, 2) ^ _rotate_right_32(a, 13) ^
        _rotate_right_32(a, 22)
      majority = ((a & b) ^ (a & c) ^ (b & c)) & _WORD_MASK
      temporary2 = (sum0 + majority) & _WORD_MASK

      h = g
      g = f
      f = e
      e = (d + temporary1) & _WORD_MASK
      d = c
      c = b
      b = a
      a = (temporary1 + temporary2) & _WORD_MASK
      round = round + 1
    end

    self.h0 = (self.h0 + a) & _WORD_MASK
    self.h1 = (self.h1 + b) & _WORD_MASK
    self.h2 = (self.h2 + c) & _WORD_MASK
    self.h3 = (self.h3 + d) & _WORD_MASK
    self.h4 = (self.h4 + e) & _WORD_MASK
    self.h5 = (self.h5 + f) & _WORD_MASK
    self.h6 = (self.h6 + g) & _WORD_MASK
    self.h7 = (self.h7 + h) & _WORD_MASK
  end

  def update(mut self, bytes: Bytes): Sha256
    length = bytes.len()
    self.byte_count = self.byte_count.wrapping_add(length)
    offset = 0

    if self.pending.len() > 0
      needed = 64 - self.pending.len()
      count = needed.min(length)
      if count > 0
        self.pending.extend(bytes.slice(0, count).expect("the pending range is valid"))
        offset = count
      end
      if self.pending.len() == 64
        self._block(self.pending.build(), 0)
        self.pending.clear()
      end
    end

    while offset + 64 <= length
      self._block(bytes, offset)
      offset = offset + 64
    end
    if offset < length
      self.pending.extend(
        bytes.slice(offset, length - offset).expect("the digest suffix is valid")
      )
    end
    self
  end

  def _finish(mut self): Bytes
    length = self.byte_count.wrapping_mul(8)
    self.pending.append(128)
    while self.pending.len() % 64 != 56
      self.pending.append(0)
    end
    shift = 56
    while shift >= 0
      self.pending.append((length >>> shift) & 255)
      shift = shift - 8
    end

    source = self.pending.build()
    offset = 0
    while offset < source.len()
      self._block(source, offset)
      offset = offset + 64
    end

    output = ByteBuffer()
    output.reserve(32)
    _append_word_be(output, self.h0)
    _append_word_be(output, self.h1)
    _append_word_be(output, self.h2)
    _append_word_be(output, self.h3)
    _append_word_be(output, self.h4)
    _append_word_be(output, self.h5)
    _append_word_be(output, self.h6)
    _append_word_be(output, self.h7)
    output.finish()
  end

  def finish(mut self): Bytes
    h0 = self.h0
    h1 = self.h1
    h2 = self.h2
    h3 = self.h3
    h4 = self.h4
    h5 = self.h5
    h6 = self.h6
    h7 = self.h7
    pending = self.pending.build()
    result = self._finish()
    self.h0 = h0
    self.h1 = h1
    self.h2 = h2
    self.h3 = h3
    self.h4 = h4
    self.h5 = h5
    self.h6 = h6
    self.h7 = h7
    self.pending.clear()
    self.pending.extend(pending)
    result
  end
end

final class Md5 implements DigestState
  type Output = Bytes

  a0: Int
  b0: Int
  c0: Int
  d0: Int
  byte_count: Int
  pending: ByteBuffer
  words: List[Int]

  def init(mut self)
    self.a0 = 0
    self.b0 = 0
    self.c0 = 0
    self.d0 = 0
    self.byte_count = 0
    self.pending = ByteBuffer()
    self.words = _word_buffer()
    self.reset()
  end

  def reset(mut self): Md5
    self.a0 = 1732584193
    self.b0 = 4023233417
    self.c0 = 2562383102
    self.d0 = 271733878
    self.byte_count = 0
    self.pending.clear()
    self
  end

  def _copy_from(mut self, other: Md5): Md5
    self.a0 = other.a0
    self.b0 = other.b0
    self.c0 = other.c0
    self.d0 = other.d0
    self.byte_count = other.byte_count
    self.pending.clear()
    self.pending.extend(other.pending.build())
    self
  end

  def copy(self): Md5
    result = Md5()
    result._copy_from(self)
  end

  def _block(mut self, source: Bytes, offset: Int)
    words = self.words
    index = 0
    while index < 16
      words.set(index, source.read_u32_le(offset + index * 4))
      index = index + 1
    end

    a = self.a0
    b = self.b0
    c = self.c0
    d = self.d0
    constants = _MD5_CONSTANTS
    shifts = _MD5_SHIFTS
    round = 0
    while round < 64
      function = 0
      word_index = 0
      if round < 16
        function = ((b & c) | ((~b) & d)) & _WORD_MASK
        word_index = round
      elsif round < 32
        function = ((d & b) | ((~d) & c)) & _WORD_MASK
        word_index = (5 * round + 1) % 16
      elsif round < 48
        function = (b ^ c ^ d) & _WORD_MASK
        word_index = (3 * round + 5) % 16
      else
        function = (c ^ (b | (~d))) & _WORD_MASK
        word_index = (7 * round) % 16
      end

      sum = (a + function + constants.read_u32_le(round * 4) +
        words.at(word_index)) & _WORD_MASK
      next_b = (b + _rotate_left_32(sum, shifts.at(round))) & _WORD_MASK
      a = d
      d = c
      c = b
      b = next_b
      round = round + 1
    end

    self.a0 = (self.a0 + a) & _WORD_MASK
    self.b0 = (self.b0 + b) & _WORD_MASK
    self.c0 = (self.c0 + c) & _WORD_MASK
    self.d0 = (self.d0 + d) & _WORD_MASK
  end

  def update(mut self, bytes: Bytes): Md5
    length = bytes.len()
    self.byte_count = self.byte_count.wrapping_add(length)
    offset = 0

    if self.pending.len() > 0
      needed = 64 - self.pending.len()
      count = needed.min(length)
      if count > 0
        self.pending.extend(bytes.slice(0, count).expect("the pending range is valid"))
        offset = count
      end
      if self.pending.len() == 64
        self._block(self.pending.build(), 0)
        self.pending.clear()
      end
    end

    while offset + 64 <= length
      self._block(bytes, offset)
      offset = offset + 64
    end
    if offset < length
      self.pending.extend(
        bytes.slice(offset, length - offset).expect("the digest suffix is valid")
      )
    end
    self
  end

  def _finish(mut self): Bytes
    length = self.byte_count.wrapping_mul(8)
    self.pending.append(128)
    while self.pending.len() % 64 != 56
      self.pending.append(0)
    end
    shift = 0
    while shift <= 56
      self.pending.append((length >>> shift) & 255)
      shift = shift + 8
    end

    source = self.pending.build()
    offset = 0
    while offset < source.len()
      self._block(source, offset)
      offset = offset + 64
    end

    output = ByteBuffer()
    output.reserve(16)
    _append_word_le(output, self.a0)
    _append_word_le(output, self.b0)
    _append_word_le(output, self.c0)
    _append_word_le(output, self.d0)
    output.finish()
  end

  def finish(mut self): Bytes
    a0 = self.a0
    b0 = self.b0
    c0 = self.c0
    d0 = self.d0
    pending = self.pending.build()
    result = self._finish()
    self.a0 = a0
    self.b0 = b0
    self.c0 = c0
    self.d0 = d0
    self.pending.clear()
    self.pending.extend(pending)
    result
  end
end

final class Crc32 implements DigestState
  type Output = Int

  checksum: Int

  def init(mut self)
    self.checksum = _WORD_MASK
  end

  def reset(mut self): Crc32
    self.checksum = _WORD_MASK
    self
  end

  def update(mut self, bytes: Bytes): Crc32
    index = 0
    length = bytes.len()
    checksum = self.checksum
    table = _CRC32_TABLE
    while index < length
      value = checksum ^ bytes.at(index)
      value = (value >>> 4) ^ table.read_u32_le((value & 15) * 4)
      value = (value >>> 4) ^ table.read_u32_le((value & 15) * 4)
      checksum = value & _WORD_MASK
      index = index + 1
    end
    self.checksum = checksum
    self
  end

  def finish(mut self): Int
    (self.checksum ^ _WORD_MASK) & _WORD_MASK
  end

  def copy(self): Crc32
    result = Crc32()
    result.checksum = self.checksum
    result
  end
end

def digest_reader[effect e, D: DigestState, R: ByteReader with e](
  mut state: D,
  reader: R
): Result[D.Output, R.Error] with e
  loop do
    bytes = reader.read(65536)?
    if bytes.is_empty()
      return Ok(state.finish())
    end
    state.update(bytes)
  end
end

def sha256(bytes: Bytes): Bytes
  state = Sha256()
  state.update(bytes)
  state.finish()
end

def sha256_hex(bytes: Bytes): String
  sha256(bytes).hex()
end

# MD5 supports compatibility protocols. It does not provide secure hashing.
def md5(bytes: Bytes): Bytes
  state = Md5()
  state.update(bytes)
  state.finish()
end

def md5_hex(bytes: Bytes): String
  md5(bytes).hex()
end

def crc32(bytes: Bytes): Int
  state = Crc32()
  state.update(bytes)
  state.finish()
end
