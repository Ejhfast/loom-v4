# Standard library: platform-explicit lexical path operations.

enum PathError implements Error
  ContainsNul
  InvalidWindowsPrefix

  def append_to(self, mut builder: StringBuilder)
    text = case self
    in ContainsNul          then "the path contains a null byte"
    in InvalidWindowsPrefix then "the Windows path prefix is invalid"
    end
    builder.append(text)
  end
end

def _is_separator(byte: Int, style: PathStyle): Bool
  case style
  in PathStyle.Posix then byte == 47
  in PathStyle.Windows then byte == 47 or byte == 92
  end
end

def _separator(style: PathStyle): String
  case style
  in PathStyle.Posix then "/"
  in PathStyle.Windows then "\\"
  end
end

def _is_ascii_letter(byte: Int): Bool
  (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122)
end

def _contains_nul(text: Text): Bool
  source = text.bytes()
  index = 0
  while index < source.len()
    if source.at(index) == 0
      return true
    end
    index = index + 1
  end
  false
end

def _text_part(text: Text, start: Int, length: Int): String
  text.slice_bytes(start, length).expect("the path slice is valid").to_string()
end

def _has_windows_drive(text: Text): Bool
  source = text.bytes()
  source.len() >= 2 and _is_ascii_letter(source.at(0)) and source.at(1) == 58
end

def parse(text: Text, style: PathStyle): Result[Path, PathError]
  if _contains_nul(text)
    Err(PathError.ContainsNul)
  elsif style == PathStyle.Windows and text.bytes().len() >= 2 and
    _is_separator(text.bytes().at(0), style) and
    _is_separator(text.bytes().at(1), style) and
    normalize(Path(text.to_string(), style)).is_err()
    Err(PathError.InvalidWindowsPrefix)
  else
    Ok(Path(text.to_string(), style))
  end
end

def is_absolute(path: Path): Bool
  source = path.value.bytes()
  if source.is_empty()
    return false
  end
  style = path.style()
  case style
  in PathStyle.Posix
    source.at(0) == 47
  in PathStyle.Windows
    (_has_windows_drive(path.value) and source.len() >= 3 and
      _is_separator(source.at(2), style)) or
      (source.len() >= 2 and _is_separator(source.at(0), style) and
        _is_separator(source.at(1), style))
  end
end

def normalize(path: Path): Result[Path, PathError]
  text = path.value
  style = path.style()
  if _contains_nul(text)
    return Err(PathError.ContainsNul)
  end
  source = text.bytes()
  segments = List[String]()
  prefix = ""
  rooted = false
  protected = 0
  index = 0

  case style
  in PathStyle.Posix
    if source.len() > 0 and source.at(0) == 47
      rooted = true
      index = 1
    end
  in PathStyle.Windows
    if _has_windows_drive(text)
      prefix = _text_part(text, 0, 2)
      index = 2
      if index < source.len() and _is_separator(source.at(index), style)
        rooted = true
        index = index + 1
      end
    elsif source.len() >= 2 and _is_separator(source.at(0), style) and
      _is_separator(source.at(1), style)
      rooted = true
      prefix = "\\\\"
      index = 2
      protected = 2
    elsif source.len() > 0 and _is_separator(source.at(0), style)
      rooted = true
      index = 1
    end
  end

  while index <= source.len()
    start = index
    while index < source.len() and not _is_separator(source.at(index), style)
      index = index + 1
    end
    if index > start
      part = _text_part(text, start, index - start)
      if part == "."
        ()
      elsif part == ".."
        if segments.len() > protected and segments.last() != Some("..")
          segments.pop()
        elsif not rooted
          segments.push(part)
        end
      else
        segments.push(part)
      end
    end
    while index < source.len() and _is_separator(source.at(index), style)
      index = index + 1
    end
    if index == source.len()
      break
    end
  end

  if style == PathStyle.Windows and prefix == "\\\\" and segments.len() < 2
    return Err(PathError.InvalidWindowsPrefix)
  end

  builder = StringBuilder()
  builder.append(prefix)
  separator = _separator(style)
  if rooted and prefix != "\\\\"
    builder.append(separator)
  end
  segment_index = 0
  while segment_index < segments.len()
    if segment_index > 0
      builder.append(separator)
    end
    builder.append(segments.at(segment_index))
    segment_index = segment_index + 1
  end
  if not rooted and prefix == "" and segments.is_empty()
    builder.append(".")
  end
  Ok(Path(builder.finish(), style))
end

def join(base: Path, child: Text): Result[Path, PathError]
  style = base.style()
  child_path = Path(child.to_string(), style)
  if is_absolute(child_path) or (style == PathStyle.Windows and _has_windows_drive(child))
    return parse(child, style)
  end
  if base.value.is_empty()
    return parse(child, style)
  end
  builder = StringBuilder()
  builder.append(base.value)
  source = base.value.bytes()
  if source.len() > 0 and not _is_separator(source.at(source.len() - 1), style)
    builder.append(_separator(style))
  end
  builder.append(child)
  parse(builder.finish(), style)
end

def _last_separator(text: Text, style: PathStyle): Int
  source = text.bytes()
  index = source.len() - 1
  while index >= 0
    if _is_separator(source.at(index), style)
      return index
    end
    index = index - 1
  end
  -1
end

def parent(path: Path): Option[Path]
  text = path.value
  style = path.style()
  if text == "." or is_absolute(path) and
    _last_separator(text, style) == text.byte_len() - 1
    return None
  end
  at = _last_separator(text, style)
  if at < 0
    Some(Path(".", style))
  elsif at == 0
    Some(Path(_separator(style), style))
  elsif style == PathStyle.Windows and at == 2 and _has_windows_drive(text)
    Some(Path(_text_part(text, 0, 3), style))
  else
    Some(Path(_text_part(text, 0, at), style))
  end
end

def file_name(path: Path): Option[String]
  text = path.value
  style = path.style()
  if text == "."
    return None
  end
  at = _last_separator(text, style)
  start = at + 1
  if start >= text.byte_len()
    None
  else
    Some(_text_part(text, start, text.byte_len() - start))
  end
end

def _last_dot(text: Text): Int
  source = text.bytes()
  index = source.len() - 1
  while index >= 0
    if source.at(index) == 46
      return index
    end
    index = index - 1
  end
  -1
end

def extension(path: Path): Option[String]
  name = case file_name(path)
  in Some(value) then value
  in None then return None
  end
  at = _last_dot(name)
  if at <= 0 or at + 1 >= name.byte_len()
    None
  else
    Some(_text_part(name, at + 1, name.byte_len() - at - 1))
  end
end

def stem(path: Path): Option[String]
  name = case file_name(path)
  in Some(value) then value
  in None then return None
  end
  at = _last_dot(name)
  if at <= 0
    Some(name)
  else
    Some(_text_part(name, 0, at))
  end
end
