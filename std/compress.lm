# Standard library: bounded gzip and zlib compression.

enum CompressionFormat
  Gzip
  Deflate
end

enum CompressionLevel
  Stored
  Fast
  Balanced
  Best
end

enum CompressionError implements Error
  InvalidData
  LimitExceeded

  def append_to(self, mut builder: StringBuilder)
    text = case self
    in InvalidData  then "the compressed data is invalid"
    in LimitExceeded then "the decompressed data exceeds its byte limit"
    end
    builder.append(text)
  end
end

def _compression_format(format: CompressionFormat): Int
  case format
  in Gzip    then 0
  in Deflate then 1
  end
end

def _compression_level(level: CompressionLevel): Int
  case level
  in Stored   then 0
  in Fast     then 1
  in Balanced then 6
  in Best     then 9
  end
end

def compress(
  bytes: Bytes,
  format: CompressionFormat,
  level: CompressionLevel
): Bytes
  _compress_encode(bytes, _compression_format(format), _compression_level(level))
end

def decompress(
  bytes: Bytes,
  format: CompressionFormat,
  max_output_bytes: Int
): Result[Bytes, CompressionError]
  if max_output_bytes < 0 or max_output_bytes > 67108864
    return Err(CompressionError.LimitExceeded)
  end
  format_code = _compression_format(format)
  status = _compress_decode_status(bytes, format_code, max_output_bytes)
  if status == 0
    Ok(_compress_decode_value(bytes, format_code, max_output_bytes))
  elsif status == 1
    Err(CompressionError.InvalidData)
  else
    Err(CompressionError.LimitExceeded)
  end
end

def gzip_compress(bytes: Bytes, level: CompressionLevel): Bytes
  compress(bytes, CompressionFormat.Gzip, level)
end

def gzip_decompress(
  bytes: Bytes,
  max_output_bytes: Int
): Result[Bytes, CompressionError]
  decompress(bytes, CompressionFormat.Gzip, max_output_bytes)
end

def deflate_compress(bytes: Bytes, level: CompressionLevel): Bytes
  compress(bytes, CompressionFormat.Deflate, level)
end

def deflate_decompress(
  bytes: Bytes,
  max_output_bytes: Int
): Result[Bytes, CompressionError]
  decompress(bytes, CompressionFormat.Deflate, max_output_bytes)
end
