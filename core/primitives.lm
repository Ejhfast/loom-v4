# Primitive values use these final core method tables.

interface Display
  def append_to(self, mut builder: StringBuilder)
end

interface PartialEq
  def __eq__(self, other: Self): Bool
end

interface Hashable: PartialEq
  def __hash__(self): Int
end

interface Comparable: PartialEq
  def compare(self, other: Self): Ordering
end

interface Copyable
  def copy(self): Self
end

interface Add
  def __add__(self, other: Self): Self
end

interface Subtract
  def __sub__(self, other: Self): Self
end

interface Multiply
  def __mul__(self, other: Self): Self
end

interface Divide
  def __div__(self, other: Self): Self
end

interface Negate
  def __neg__(self): Self
end

interface Number: Add, Subtract, Multiply, Divide, Comparable
  def min(self, other: Self): Self
  def max(self, other: Self): Self
end

interface SignedNumber: Number, Negate
  def abs(self): Self
end

interface Error: Display
end

def display[T: Display](value: T): String
  builder = StringBuilder()
  value.append_to(builder)
  builder.finish()
end

def hash_of[T: Hashable](value: T): Int
  value.__hash__()
end

def hash_combine(seed: Int, value: Int): Int
  intrinsic("hash.combine", seed, value)
end

final class Int implements Display, Hashable, SignedNumber
  def append_to(self, mut builder: StringBuilder)
    builder.append_int(self)
  end

  def abs(self): Int
    intrinsic("int.abs", self)
  end

  def min(self, other: Int): Int
    if self < other
      self
    else
      other
    end
  end

  def max(self, other: Int): Int
    if self > other
      self
    else
      other
    end
  end

  def __neg__(self): Int
    intrinsic("int.neg", self)
  end

  def __add__(self, other: Int): Int
    intrinsic("int.add", self, other)
  end

  def __sub__(self, other: Int): Int
    intrinsic("int.sub", self, other)
  end

  def __mul__(self, other: Int): Int
    intrinsic("int.mul", self, other)
  end

  def __div__(self, other: Int): Int
    intrinsic("int.div", self, other)
  end

  def __rem__(self, other: Int): Int
    intrinsic("int.rem", self, other)
  end

  def bit_and(self, other: Int): Int
    intrinsic("int.bit_and", self, other)
  end

  def bit_or(self, other: Int): Int
    intrinsic("int.bit_or", self, other)
  end

  def bit_xor(self, other: Int): Int
    intrinsic("int.bit_xor", self, other)
  end

  def bit_not(self): Int
    intrinsic("int.bit_not", self)
  end

  def shl(self, amount: Int): Int
    intrinsic("int.shl", self, amount)
  end

  def shr(self, amount: Int): Int
    intrinsic("int.shr", self, amount)
  end

  def ushr(self, amount: Int): Int
    intrinsic("int.ushr", self, amount)
  end

  def wrapping_add(self, other: Int): Int
    intrinsic("int.wrapping_add", self, other)
  end

  def wrapping_sub(self, other: Int): Int
    intrinsic("int.wrapping_sub", self, other)
  end

  def wrapping_mul(self, other: Int): Int
    intrinsic("int.wrapping_mul", self, other)
  end

  def rotate_left(self, amount: Int): Int
    intrinsic("int.rotate_left", self, amount)
  end

  def rotate_right(self, amount: Int): Int
    intrinsic("int.rotate_right", self, amount)
  end

  def count_ones(self): Int
    intrinsic("int.count_ones", self)
  end

  def leading_zeros(self): Int
    intrinsic("int.leading_zeros", self)
  end

  def trailing_zeros(self): Int
    intrinsic("int.trailing_zeros", self)
  end

  def signum(self): Int
    intrinsic("int.signum", self)
  end

  def to_float(self): Float
    intrinsic("int.to_float", self)
  end

  def __and__(self, other: Int): Int
    self.bit_and(other)
  end

  def __or__(self, other: Int): Int
    self.bit_or(other)
  end

  def __xor__(self, other: Int): Int
    self.bit_xor(other)
  end

  def __invert__(self): Int
    self.bit_not()
  end

  def __shl__(self, amount: Int): Int
    self.shl(amount)
  end

  def __shr__(self, amount: Int): Int
    self.shr(amount)
  end

  def __ushr__(self, amount: Int): Int
    self.ushr(amount)
  end

  def __eq__(self, other: Int): Bool
    intrinsic("int.eq", self, other)
  end

  def __hash__(self): Int
    self
  end

  def compare(self, other: Int): Ordering
    if self < other
      Less
    elsif self > other
      Greater
    else
      Equal
    end
  end

  def __lt__(self, other: Int): Bool
    intrinsic("int.lt", self, other)
  end

  def __le__(self, other: Int): Bool
    intrinsic("int.le", self, other)
  end

  def __gt__(self, other: Int): Bool
    intrinsic("int.gt", self, other)
  end

  def __ge__(self, other: Int): Bool
    intrinsic("int.ge", self, other)
  end
end

final class Float implements Display, Hashable, SignedNumber
  def append_to(self, mut builder: StringBuilder)
    builder.append_float(self)
  end

  def __neg__(self): Float
    intrinsic("float.neg", self)
  end

  def __add__(self, other: Float): Float
    intrinsic("float.add", self, other)
  end

  def __sub__(self, other: Float): Float
    intrinsic("float.sub", self, other)
  end

  def __mul__(self, other: Float): Float
    intrinsic("float.mul", self, other)
  end

  def __div__(self, other: Float): Float
    intrinsic("float.div", self, other)
  end

  def __rem__(self, other: Float): Float
    intrinsic("float.rem", self, other)
  end

  def abs(self): Float
    intrinsic("float.abs", self)
  end

  def min(self, other: Float): Float
    intrinsic("float.min", self, other)
  end

  def max(self, other: Float): Float
    intrinsic("float.max", self, other)
  end

  def sqrt(self): Float
    intrinsic("float.sqrt", self)
  end

  def floor(self): Float
    intrinsic("float.floor", self)
  end

  def ceil(self): Float
    intrinsic("float.ceil", self)
  end

  def round(self): Float
    intrinsic("float.round", self)
  end

  def trunc(self): Float
    intrinsic("float.trunc", self)
  end

  def copy_sign(self, sign: Float): Float
    intrinsic("float.copy_sign", self, sign)
  end

  def mul_add(self, multiplier: Float, addend: Float): Float
    intrinsic("float.mul_add", self, multiplier, addend)
  end

  def pow(self, exponent: Float): Float
    intrinsic("float.pow", self, exponent)
  end

  def exp(self): Float
    intrinsic("float.exp", self)
  end

  def exp2(self): Float
    intrinsic("float.exp2", self)
  end

  def exp_m1(self): Float
    intrinsic("float.exp_m1", self)
  end

  def ln(self): Float
    intrinsic("float.ln", self)
  end

  def log2(self): Float
    intrinsic("float.log2", self)
  end

  def log10(self): Float
    intrinsic("float.log10", self)
  end

  def ln_1p(self): Float
    intrinsic("float.ln_1p", self)
  end

  def cbrt(self): Float
    intrinsic("float.cbrt", self)
  end

  def hypot(self, other: Float): Float
    intrinsic("float.hypot", self, other)
  end

  def sin(self): Float
    intrinsic("float.sin", self)
  end

  def cos(self): Float
    intrinsic("float.cos", self)
  end

  def tan(self): Float
    intrinsic("float.tan", self)
  end

  def asin(self): Float
    intrinsic("float.asin", self)
  end

  def acos(self): Float
    intrinsic("float.acos", self)
  end

  def atan(self): Float
    intrinsic("float.atan", self)
  end

  def atan2(self, other: Float): Float
    intrinsic("float.atan2", self, other)
  end

  def sinh(self): Float
    intrinsic("float.sinh", self)
  end

  def cosh(self): Float
    intrinsic("float.cosh", self)
  end

  def tanh(self): Float
    intrinsic("float.tanh", self)
  end

  def asinh(self): Float
    intrinsic("float.asinh", self)
  end

  def acosh(self): Float
    intrinsic("float.acosh", self)
  end

  def atanh(self): Float
    intrinsic("float.atanh", self)
  end

  def __eq__(self, other: Float): Bool
    intrinsic("float.eq", self, other)
  end

  def __hash__(self): Int
    intrinsic("float.hash", self)
  end

  def __lt__(self, other: Float): Bool
    intrinsic("float.lt", self, other)
  end

  def __le__(self, other: Float): Bool
    intrinsic("float.le", self, other)
  end

  def __gt__(self, other: Float): Bool
    intrinsic("float.gt", self, other)
  end

  def __ge__(self, other: Float): Bool
    intrinsic("float.ge", self, other)
  end

  def is_nan(self): Bool
    intrinsic("float.is_nan", self)
  end

  def is_finite(self): Bool
    intrinsic("float.is_finite", self)
  end

  def is_infinite(self): Bool
    intrinsic("float.is_infinite", self)
  end

  def bits(self): Int
    intrinsic("float.bits", self)
  end

  def to_int(self): Result[Int, FloatToIntError]
    status = intrinsic("float.to_int_status", self)
    if status == 1
      Err(FloatToIntError.NonFinite)
    elsif status == 2
      Err(FloatToIntError.OutOfRange)
    else
      Ok(intrinsic("float.to_int_value", self))
    end
  end

  def fixed(self, digits: Int): String
    intrinsic("float.fixed", self, digits)
  end

  def compare(self, other: Float): Ordering
    if self == other
      Equal
    elsif self.is_nan()
      Greater
    elsif other.is_nan()
      Less
    elsif self < other
      Less
    else
      Greater
    end
  end
end

final class Bool implements Display, Hashable, Comparable
  def append_to(self, mut builder: StringBuilder)
    builder.append_bool(self)
  end

  def __not__(self): Bool
    intrinsic("bool.not", self)
  end

  def __eq__(self, other: Bool): Bool
    intrinsic("bool.eq", self, other)
  end

  def __hash__(self): Int
    if self
      1
    else
      0
    end
  end

  def compare(self, other: Bool): Ordering
    if self == other
      Equal
    elsif self
      Greater
    else
      Less
    end
  end

end
