# Core: portable operation errors.
#
# These values describe portable text conversion and index failures.

enum IoError
  Failed(message: String)

  def message(self): String
    case self
    in Failed(m) then m
    end
  end
end

enum Utf8Error
  OutOfBounds
  InvalidBoundary
  InvalidEncoding
end

enum IndexError
  OutOfBounds
end

enum ParseIntError
  Invalid
  Overflow
end
