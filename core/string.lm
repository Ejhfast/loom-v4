# Core: immutable UTF-8 text and Unicode scalar values.

class Text implements Counted, Iterable, Display, Hashable, Comparable
  type Item = Char
  type Iter = TextIterator

  def append_to(self, mut builder: StringBuilder)
    builder.append(self)
  end

  def len(self): Int
    intrinsic("text.len", self)
  end

  def byte_len(self): Int
    intrinsic("text.byte_len", self)
  end

  def is_empty(self): Bool
    self.len() == 0
  end

  def iterator(self): TextIterator
    TextIterator(self)
  end

  def at(self, index: Int): Option[Char]
    if index < 0 or index >= self.len()
      None
    else
      Some(intrinsic("text.at", self, index))
    end
  end

  def slice(self, start: Int, length: Int): Result[Substring, IndexError]
    text_length = self.len()
    if start < 0 or length < 0
      Err(IndexError.OutOfBounds)
    elsif start > text_length
      Err(IndexError.OutOfBounds)
    elsif length > text_length - start
      Err(IndexError.OutOfBounds)
    else
      Ok(intrinsic("text.slice", self, start, length))
    end
  end

  def slice_bytes(self, start: Int, length: Int): Result[Substring, Utf8Error]
    text_length = self.byte_len()
    if start < 0 or length < 0
      Err(Utf8Error.OutOfBounds)
    elsif start > text_length
      Err(Utf8Error.OutOfBounds)
    elsif length > text_length - start
      Err(Utf8Error.OutOfBounds)
    elsif not intrinsic("text.is_boundary", self, start)
      Err(Utf8Error.InvalidBoundary)
    elsif not intrinsic("text.is_boundary", self, start + length)
      Err(Utf8Error.InvalidBoundary)
    else
      Ok(intrinsic("text.slice_bytes", self, start, length))
    end
  end

  def find(self, needle: Text): Option[Int]
    index = intrinsic("text.find_index", self, needle)
    if index < 0
      None
    else
      Some(index)
    end
  end

  def find_bytes(self, needle: Text): Option[Int]
    index = intrinsic("text.find_byte_index", self, needle)
    if index < 0
      None
    else
      Some(index)
    end
  end

  def each[effect e](self, f: (Char) -> () with e): () with e
    index = 0
    length = self.byte_len()
    while index < length
      value = intrinsic("text.at_byte", self, index)
      f(value)
      index = index + value.utf8_len()
    end
  end

  def map[effect e](self, f: (Char) -> Char with e): String with e
    builder = StringBuilder()
    index = 0
    length = self.byte_len()
    while index < length
      value = intrinsic("text.at_byte", self, index)
      builder.push_char(f(value))
      index = index + value.utf8_len()
    end
    builder.finish()
  end

  def starts_with(self, prefix: Text): Bool
    intrinsic("text.starts_with", self, prefix)
  end

  def ends_with(self, suffix: Text): Bool
    intrinsic("text.ends_with", self, suffix)
  end

  def contains(self, needle: Text): Bool
    intrinsic("text.contains", self, needle)
  end

  def bytes(self): Bytes
    intrinsic("text.bytes", self)
  end

  # `split` is total. A separator can come from data, so no input
  # makes it fault. An empty separator matches at every scalar
  # boundary, and the result holds one empty piece at each end.
  def split(self, separator: Text): List[Substring]
    intrinsic("text.split", self, separator)
  end

  # `lines` accepts a line feed with or without a carriage return.
  # A final line feed ends the last line and adds no empty piece.
  def lines(self): List[Substring]
    intrinsic("text.lines", self)
  end

  def trim(self): Substring
    intrinsic("text.trim", self)
  end

  def trim_start(self): Substring
    intrinsic("text.trim_start", self)
  end

  def trim_end(self): Substring
    intrinsic("text.trim_end", self)
  end

  def pad_start(self, width: Int): String
    intrinsic("text.pad_start", self, width)
  end

  def pad_end(self, width: Int): String
    intrinsic("text.pad_end", self, width)
  end

  def to_lower_ascii(self): String
    intrinsic("text.to_lower_ascii", self)
  end

  def to_upper_ascii(self): String
    intrinsic("text.to_upper_ascii", self)
  end

  def replace(self, needle: Text, replacement: Text): String
    intrinsic("text.replace", self, needle, replacement)
  end

  # `parse_int` is total. Both the text and the radix can come from
  # data, so no input makes it fault.
  def parse_int(self, radix: Int): Result[Int, ParseIntError]
    status = intrinsic("text.parse_int_status", self, radix)
    if status == 0
      Ok(intrinsic("text.parse_int_value", self, radix))
    elsif status == 2
      Err(ParseIntError.Overflow)
    elsif status == 3
      Err(ParseIntError.BadRadix)
    else
      Err(ParseIntError.Invalid)
    end
  end

  # `parse_float` accepts decimal text and the three values emitted
  # for non-finite floats. No input makes this method fault.
  def parse_float(self): Result[Float, ParseFloatError]
    status = intrinsic("text.parse_float_status", self)
    if status == 0
      Ok(intrinsic("text.parse_float_value", self))
    elsif status == 2
      Err(ParseFloatError.Overflow)
    else
      Err(ParseFloatError.Invalid)
    end
  end

  # The three methods below compose `find_bytes` and `slice_bytes`.
  # Each one gives a valid piece, so a caller never handles a
  # boundary error that cannot happen.

  # Each body names the raw slice intrinsic and not `slice_bytes`.
  # A match offset already sits on a scalar boundary, so the checked
  # wrapper would build a `Result` that no caller can observe and no
  # input can make fail.

  def split_once(self, separator: Text): Option[(Substring, Substring)]
    at = intrinsic("text.find_byte_index", self, separator)
    if at < 0
      None
    else
      rest = at + separator.byte_len()
      head = intrinsic("text.slice_bytes", self, 0, at)
      tail = intrinsic("text.slice_bytes", self, rest, self.byte_len() - rest)
      Some((head, tail))
    end
  end

  def strip_prefix(self, prefix: Text): Option[Substring]
    if self.starts_with(prefix)
      start = prefix.byte_len()
      Some(intrinsic("text.slice_bytes", self, start, self.byte_len() - start))
    else
      None
    end
  end

  def strip_suffix(self, suffix: Text): Option[Substring]
    if self.ends_with(suffix)
      Some(intrinsic("text.slice_bytes", self, 0, self.byte_len() - suffix.byte_len()))
    else
      None
    end
  end

  def concat(self, other: Text): String
    intrinsic("text.concat", self, other)
  end

  def __add__(self, other: Text): String
    intrinsic("text.concat", self, other)
  end

  def __eq__(self, other: Text): Bool
    intrinsic("text.eq", self, other)
  end

  def __hash__(self): Int
    intrinsic("text.hash", self)
  end

  def compare(self, other: Text): Ordering
    if self < other
      Less
    elsif self > other
      Greater
    else
      Equal
    end
  end

  def __lt__(self, other: Text): Bool
    intrinsic("text.lt", self, other)
  end

  def __le__(self, other: Text): Bool
    intrinsic("text.le", self, other)
  end

  def __gt__(self, other: Text): Bool
    intrinsic("text.gt", self, other)
  end

  def __ge__(self, other: Text): Bool
    intrinsic("text.ge", self, other)
  end
end

final class String < Text
end

final class Substring < Text
  def to_string(self): String
    intrinsic("substring.to_string", self)
  end

  def compact(self): String
    intrinsic("substring.to_string", self)
  end
end

final class Char implements Display, Hashable, Comparable
  def append_to(self, mut builder: StringBuilder)
    builder.push_char(self)
  end

  def codepoint(self): Int
    intrinsic("char.codepoint", self)
  end

  def utf8_len(self): Int
    intrinsic("char.utf8_len", self)
  end

  def is_ascii(self): Bool
    self.codepoint() < 128
  end

  def __eq__(self, other: Char): Bool
    intrinsic("char.eq", self, other)
  end

  def __hash__(self): Int
    self.codepoint()
  end

  def compare(self, other: Char): Ordering
    if self < other
      Less
    elsif self > other
      Greater
    else
      Equal
    end
  end

  def __lt__(self, other: Char): Bool
    intrinsic("char.lt", self, other)
  end

  def __le__(self, other: Char): Bool
    intrinsic("char.le", self, other)
  end

  def __gt__(self, other: Char): Bool
    intrinsic("char.gt", self, other)
  end

  def __ge__(self, other: Char): Bool
    intrinsic("char.ge", self, other)
  end
end
