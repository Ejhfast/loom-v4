# Core: explicit TLS client configuration and stream resources.

enum TlsError
  InvalidConfig(message: String)
  Handshake(message: String)
  Certificate(message: String)
  Protocol(message: String)
  Network(error: NetError)
  Closed
  LimitExceeded(message: String)

  def message(self): String
    case self
    in InvalidConfig(value) then value
    in Handshake(value)     then value
    in Certificate(value)   then value
    in Protocol(value)      then value
    in Network(error)       then error.message()
    in Closed               then "TLS stream is closed"
    in LimitExceeded(value) then value
    end
  end
end

enum TlsRoots
  WebPki
  Custom(certificates: [Bytes])
end

enum TlsVersion
  Tls12
  Tls13
end

final class TlsClientConfig
  server_name: String
  roots: TlsRoots
  alpn: [Bytes]
  minimum_version: TlsVersion
  max_buffer_bytes: Int

  def init(
    mut self,
    server_name: String,
    roots: TlsRoots,
    alpn: [Bytes],
    minimum_version: TlsVersion,
    max_buffer_bytes: Int
  )
    self.server_name = server_name
    self.roots = roots
    self.alpn = alpn
    self.minimum_version = minimum_version
    self.max_buffer_bytes = max_buffer_bytes
  end
end

final class TlsStream
  def read(self, max_bytes: Int): Result[TcpRead, TlsError] with Tls.Read
    sys.tls.read(self, max_bytes)
  end

  def write(self, bytes: Bytes): Result[Int, TlsError] with Tls.Write
    sys.tls.write(self, bytes)
  end

  def shutdown(self): Result[(), TlsError] with Tls.Shutdown
    sys.tls.shutdown(self)
  end

  def local_address(self): Result[SocketAddress, TlsError] with Tls.LocalAddress
    sys.tls.local_address(self)
  end

  def peer_address(self): Result[SocketAddress, TlsError] with Tls.PeerAddress
    sys.tls.peer_address(self)
  end

  def close(self): Result[(), TlsError] with Tls.Close
    sys.tls.close(self)
  end

  def write_all(self, bytes: Bytes): Result[(), TlsError] with Tls.Stream
    offset = 0
    while offset < bytes.len()
      remaining = bytes.len() - offset
      count = if remaining < 65535
        remaining
      else
        65535
      end
      part = case bytes.slice(offset, count)
      in Ok(value) then value
      in Err(_)
        return Err(TlsError.Protocol("the TLS write suffix is invalid"))
      end
      case self.write(part)
      in Ok(written)
        if written <= 0
          return Err(TlsError.Protocol("the TLS stream made no write progress"))
        end
        offset = offset + written
      in Err(error)
        return Err(error)
      end
    end
    Ok(())
  end

  def read_exact(self, count: Int): Result[Bytes, TlsError] with Tls.Stream
    if count < 0
      return Err(TlsError.InvalidConfig("the TLS read count is negative"))
    end
    buffer = ByteBuffer()
    while buffer.len() < count
      remaining = count - buffer.len()
      chunk = if remaining < 65535
        remaining
      else
        65535
      end
      case self.read(chunk)
      in Ok(TcpRead.Data(bytes))
        buffer.extend(bytes)
      in Ok(TcpRead.End)
        return Err(TlsError.Protocol("the TLS stream ended before the read completed"))
      in Err(error)
        return Err(error)
      end
    end
    Ok(buffer.finish())
  end

  def read_to_end(self, max_total: Int): Result[Bytes, TlsError] with Tls.Stream
    if max_total < 0
      return Err(TlsError.InvalidConfig("the TLS byte limit is negative"))
    end
    buffer = ByteBuffer()
    loop do
      remaining = max_total - buffer.len()
      count = if remaining < 65535
        remaining + 1
      else
        65535
      end
      case self.read(count)
      in Ok(TcpRead.Data(bytes))
        if bytes.len() > remaining
          return Err(TlsError.LimitExceeded("the TLS stream passed the byte limit"))
        end
        buffer.extend(bytes)
      in Ok(TcpRead.End)
        return Ok(buffer.finish())
      in Err(error)
        return Err(error)
      end
    end
  end
end

final class Tls
  def default_config(self, server_name: String): TlsClientConfig
    TlsClientConfig(
      server_name,
      TlsRoots.WebPki,
      [Bytes("http/1.1")],
      TlsVersion.Tls12,
      65536
    ).freeze()
  end

  def validate_config(self, config: TlsClientConfig): Result[(), TlsError]
    name = config.server_name.bytes()
    if name.len() == 0 or name.len() > 253
      return Err(TlsError.InvalidConfig("the TLS server name length is invalid"))
    end
    index = 0
    while index < name.len()
      byte = name.at(index)
      if byte <= 32 or byte >= 127
        return Err(TlsError.InvalidConfig("the TLS server name is invalid"))
      end
      index = index + 1
    end
    if config.max_buffer_bytes <= 0 or config.max_buffer_bytes > 1048576
      return Err(TlsError.InvalidConfig("the TLS buffer limit is invalid"))
    end
    if config.alpn.len() > 32
      return Err(TlsError.InvalidConfig("the TLS ALPN list is too large"))
    end
    total = 0
    index = 0
    while index < config.alpn.len()
      protocol = config.alpn.at(index)
      if protocol.len() == 0 or protocol.len() > 255
        return Err(TlsError.InvalidConfig("a TLS ALPN value has an invalid length"))
      end
      total = total + protocol.len()
      if total > 4096
        return Err(TlsError.InvalidConfig("the TLS ALPN data is too large"))
      end
      index = index + 1
    end
    case config.roots
    in TlsRoots.WebPki then ()
    in TlsRoots.Custom(certificates)
      if certificates.len() == 0 or certificates.len() > 128
        return Err(TlsError.InvalidConfig("the TLS root list size is invalid"))
      end
      total = 0
      index = 0
      while index < certificates.len()
        certificate = certificates.at(index)
        if certificate.len() == 0 or certificate.len() > 1048576
          return Err(TlsError.InvalidConfig("a TLS root certificate size is invalid"))
        end
        total = total + certificate.len()
        if total > 4194304
          return Err(TlsError.InvalidConfig("the TLS root data is too large"))
        end
        index = index + 1
      end
    end
    Ok(())
  end

  def handshake(
    self,
    stream: TcpStream,
    config: TlsClientConfig
  ): Result[TlsStream, TlsError] with Tls.Handshake
    case self.validate_config(config)
    in Err(error)
      return Err(error)
    in Ok(_) then ()
    end
    minimum = case config.minimum_version
    in TlsVersion.Tls12 then 12
    in TlsVersion.Tls13 then 13
    end
    case config.roots
    in TlsRoots.WebPki
      sys.tls.handshake(
        stream,
        config.server_name,
        0,
        [],
        config.alpn,
        minimum,
        config.max_buffer_bytes
      )
    in TlsRoots.Custom(certificates)
      sys.tls.handshake(
        stream,
        config.server_name,
        1,
        certificates,
        config.alpn,
        minimum,
        config.max_buffer_bytes
      )
    end
  end

  def connect_host(
    self,
    host: String,
    port: Int,
    config: TlsClientConfig
  ): Result[TlsStream, TlsError] with Dns.Resolve, Tcp.Client, Tls.Client
    case self.validate_config(config)
    in Err(error)
      return Err(error)
    in Ok(_) then ()
    end
    stream = case Tcp().connect_host(host, port)
    in Ok(value) then value
    in Err(error)
      return Err(TlsError.Network(error))
    end
    self.handshake(stream, config)
  end
end
