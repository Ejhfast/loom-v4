# Core: virtual machine event enums.
#
# The VM control operations reply with these values. `Fault` and
# `Request` are native holder-local types declared by the ABI.

enum StepEvent[T]
  Ran
  Waiting
  Done(value: T)
  Fault(fault: Fault)
end

enum DriveEvent[T]
  Asked(request: Request)
  Done(value: T)
  Fault(fault: Fault)
end
