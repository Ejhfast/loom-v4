# Core: Option[T].
#
# Absence is a value. There is no nil.

enum Option[T] implements Display when T: Display,
                          PartialEq when T: PartialEq,
                          Hashable when T: Hashable
  Some(v: T)
  None

  def is_some(self): Bool
    case self
    in Some(_) then true
    in None    then false
    end
  end

  def is_none(self): Bool
    case self
    in Some(_) then false
    in None    then true
    end
  end

  def value_or(self, fallback: T): T
    case self
    in Some(v) then v
    in None    then fallback
    end
  end

  def expect(self, message: String): T
    case self
    in Some(v) then v
    in None    then panic(message)
    end
  end

  def append_to(self, mut builder: StringBuilder) when T: Display
    case self
    in Some(value)
      builder.append("Some(")
      value.append_to(builder)
      builder.append(")")
      ()
    in None
      builder.append("None")
      ()
    end
  end

  def __eq__(self, other: Option[T]): Bool when T: PartialEq
    case self
    in Some(value)
      case other
      in Some(other_value) then value == other_value
      in None then false
      end
    in None
      other.is_none()
    end
  end

  def __hash__(self): Int when T: Hashable
    case self
    in Some(value) then hash_combine(1, value.__hash__())
    in None then hash_combine(0, 0)
    end
  end
end
