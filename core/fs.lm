# Core: portable file operation values.

enum PathStyle
  Posix
  Windows
end

frozen class Path implements Display, Hashable
  value: String
  windows: Bool

  def init(mut self, value: String, style: PathStyle)
    self.value = value
    self.windows = case style
    in PathStyle.Posix then false
    in PathStyle.Windows then true
    end
  end

  def append_to(self, mut builder: StringBuilder)
    builder.append(self.value)
  end

  def __eq__(self, other: Path): Bool
    self.value == other.value and self.windows == other.windows
  end

  def __hash__(self): Int
    style_hash = if self.windows then 1 else 0 end
    hash_combine(style_hash, hash_of(self.value))
  end

  def style(self): PathStyle
    if self.windows then PathStyle.Windows else PathStyle.Posix end
  end
end

enum FsError implements Error
  Closed
  InvalidInput(message: String)
  InvalidEncoding(message: String)
  LimitExceeded(message: String)
  NotFound(message: String)
  AlreadyExists(message: String)
  PermissionDenied(message: String)
  NotDirectory(message: String)
  IsDirectory(message: String)
  DirectoryNotEmpty(message: String)
  CrossDevice(message: String)
  Unsupported(message: String)
  Failed(message: String)

  def append_to(self, mut builder: StringBuilder)
    text = case self
    in Closed               then "file handle is closed"
    in InvalidInput(m)      then m
    in InvalidEncoding(m)   then m
    in LimitExceeded(m)     then m
    in NotFound(m)          then m
    in AlreadyExists(m)     then m
    in PermissionDenied(m)  then m
    in NotDirectory(m)      then m
    in IsDirectory(m)       then m
    in DirectoryNotEmpty(m) then m
    in CrossDevice(m)       then m
    in Unsupported(m)       then m
    in Failed(m)            then m
    end
    builder.append(text)
  end
end

enum OpenOptions
  ReadOnly
  WriteOnly
  ReadWrite
  Create
  CreateTruncate
  CreateNew
  Append
end

enum SeekFrom
  Start(offset: Int)
  Current(offset: Int)
  End(offset: Int)
end

enum FileKind
  File
  Directory
  Symlink
  Other
end

final class FileInfo
  kind: FileKind
  byte_length: Int
  modified_ns: Option[Int]
  read_only: Bool

  def init(
    mut self,
    kind: FileKind,
    byte_length: Int,
    modified_ns: Option[Int],
    read_only: Bool
  )
    self.kind = kind
    self.byte_length = byte_length
    self.modified_ns = modified_ns
    self.read_only = read_only
  end
end

final class DirEntry
  name: String
  kind: FileKind

  def init(mut self, name: String, kind: FileKind)
    self.name = name
    self.kind = kind
  end
end

enum RenameMode
  NoReplace
  Replace
end

final class FileHandle implements ByteReader with Fs.Read, ByteWriter with Fs.Write
  type Error = FsError

  def read(self, max_bytes: Int): Result[Bytes, FsError] with Fs.Read
    sys.fs.read(self, max_bytes)
  end

  def write(self, bytes: Bytes): Result[Int, FsError] with Fs.Write
    sys.fs.write(self, bytes)
  end

  def seek(self, from: SeekFrom): Result[Int, FsError] with Fs.Seek
    sys.fs.seek(self, from)
  end

  def flush(self): Result[(), FsError] with Fs.Flush
    sys.fs.flush(self)
  end

  def sync(self): Result[(), FsError] with Fs.Sync
    sys.fs.sync(self)
  end

  def close(self): Result[(), FsError] with Fs.Close
    sys.fs.close(self)
  end
end
