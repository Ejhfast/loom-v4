# Core: portable file operation values.

enum FsError
  Closed
  Failed(message: String)

  def message(self): String
    case self
    in Closed    then "file handle is closed"
    in Failed(m) then m
    end
  end
end

enum OpenOptions
  ReadOnly
  WriteOnly
  ReadWrite
  Create
  CreateTruncate
  Append
end

enum SeekFrom
  Start(offset: Int)
  Current(offset: Int)
  End(offset: Int)
end
