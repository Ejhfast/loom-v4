# Core: immutable bytes and mutable builders.

enum HexError implements Error
  OddLength
  InvalidDigit(index: Int)

  def append_to(self, mut builder: StringBuilder)
    case self
    in OddLength
      builder.append("hex text needs an even byte length")
    in InvalidDigit(index)
      builder.append("hex text has an invalid digit at byte ")
      builder.append_int(index)
    end
  end
end

final class Bytes implements Hashable, Comparable, Add
  def len(self): Int
    intrinsic("bytes.len", self)
  end

  def is_empty(self): Bool
    self.len() == 0
  end

  def at(self, index: Int): Int
    intrinsic("bytes.at", self, index)
  end

  def get(self, index: Int): Option[Int]
    value = intrinsic("bytes.get", self, index)
    if value < 0
      None
    else
      Some(value)
    end
  end

  def read_u32_be(self, offset: Int): Int
    intrinsic("bytes.read_u32_be", self, offset)
  end

  def read_u32_le(self, offset: Int): Int
    intrinsic("bytes.read_u32_le", self, offset)
  end

  def slice(self, start: Int, length: Int): Result[Bytes, IndexError]
    byte_length = self.len()
    if start < 0 or length < 0
      Err(IndexError.OutOfBounds)
    elsif start > byte_length
      Err(IndexError.OutOfBounds)
    elsif length > byte_length - start
      Err(IndexError.OutOfBounds)
    else
      Ok(intrinsic("bytes.slice", self, start, length))
    end
  end

  def compact(self): Bytes
    intrinsic("bytes.compact", self)
  end

  def concat(self, other: Bytes): Bytes
    intrinsic("bytes.concat", self, other)
  end

  def starts_with(self, prefix: Bytes): Bool
    intrinsic("bytes.starts_with", self, prefix)
  end

  def ends_with(self, suffix: Bytes): Bool
    intrinsic("bytes.ends_with", self, suffix)
  end

  def contains(self, needle: Bytes): Bool
    intrinsic("bytes.contains", self, needle)
  end

  def find(self, needle: Bytes): Option[Int]
    index = intrinsic("bytes.find_index", self, needle)
    if index < 0
      None
    else
      Some(index)
    end
  end

  def hex(self): String
    intrinsic("bytes.hex", self)
  end

  def utf8(self): Result[String, Utf8Error]
    if intrinsic("bytes.is_utf8", self)
      Ok(intrinsic("bytes.text", self))
    else
      Err(Utf8Error.InvalidEncoding)
    end
  end

  def utf8_view(self): Result[Substring, Utf8Error]
    if intrinsic("bytes.is_utf8", self)
      Ok(intrinsic("bytes.text_view", self))
    else
      Err(Utf8Error.InvalidEncoding)
    end
  end

  def text(self): String
    intrinsic("bytes.text", self)
  end

  def text_range(self, start: Int, length: Int): String
    intrinsic("bytes.text_range", self, start, length)
  end

  def intern_text_range(
    self,
    mut pool: Map[String, String],
    start: Int,
    length: Int
  ): String
    intrinsic("map.intern_text_range", pool, self, start, length)
  end

  def __add__(self, other: Bytes): Bytes
    intrinsic("bytes.concat", self, other)
  end

  def __and__(self, other: Bytes): Bytes
    intrinsic("bytes.bit_and", self, other)
  end

  def __or__(self, other: Bytes): Bytes
    intrinsic("bytes.bit_or", self, other)
  end

  def __xor__(self, other: Bytes): Bytes
    intrinsic("bytes.bit_xor", self, other)
  end

  def __invert__(self): Bytes
    intrinsic("bytes.bit_not", self)
  end

  def __eq__(self, other: Bytes): Bool
    intrinsic("bytes.eq", self, other)
  end

  def __hash__(self): Int
    intrinsic("bytes.hash", self)
  end

  def compare(self, other: Bytes): Ordering
    if self < other
      Less
    elsif self > other
      Greater
    else
      Equal
    end
  end

  def __lt__(self, other: Bytes): Bool
    intrinsic("bytes.lt", self, other)
  end

  def __le__(self, other: Bytes): Bool
    intrinsic("bytes.le", self, other)
  end

  def __gt__(self, other: Bytes): Bool
    intrinsic("bytes.gt", self, other)
  end

  def __ge__(self, other: Bytes): Bool
    intrinsic("bytes.ge", self, other)
  end
end

def _bytes_from_hex(text: Text): Result[Bytes, HexError]
  source = text.bytes()
  if source.len() % 2 != 0
    return Err(HexError.OddLength)
  end
  output = ByteBuffer()
  index = 0
  while index < source.len()
    high_byte = source.at(index)
    high = if high_byte >= 48 and high_byte <= 57
      high_byte - 48
    elsif high_byte >= 65 and high_byte <= 70
      high_byte - 55
    elsif high_byte >= 97 and high_byte <= 102
      high_byte - 87
    else
      -1
    end
    if high < 0
      return Err(HexError.InvalidDigit(index))
    end

    low_byte = source.at(index + 1)
    low = if low_byte >= 48 and low_byte <= 57
      low_byte - 48
    elsif low_byte >= 65 and low_byte <= 70
      low_byte - 55
    elsif low_byte >= 97 and low_byte <= 102
      low_byte - 87
    else
      -1
    end
    if low < 0
      return Err(HexError.InvalidDigit(index + 1))
    end

    output.append(high * 16 + low)
    index = index + 2
  end
  Ok(output.finish())
end

final class StringBuilder implements Copyable
  def append(mut self, text: Text): StringBuilder
    intrinsic("string_builder.append", self, text)
  end

  def append_int(mut self, value: Int): StringBuilder
    intrinsic("string_builder.append_int", self, value)
  end

  def append_bool(mut self, value: Bool): StringBuilder
    intrinsic("string_builder.append_bool", self, value)
  end

  def append_float(mut self, value: Float): StringBuilder
    intrinsic("string_builder.append_float", self, value)
  end

  def push_char(mut self, value: Char): StringBuilder
    intrinsic("string_builder.push_char", self, value)
  end

  def len(self): Int
    intrinsic("string_builder.len", self)
  end

  def byte_len(self): Int
    intrinsic("string_builder.byte_len", self)
  end

  def clear(mut self): StringBuilder
    intrinsic("string_builder.clear", self)
  end

  def build(self): String
    intrinsic("string_builder.build", self)
  end

  def finish(mut self): String
    intrinsic("string_builder.finish", self)
  end

  def copy(self): StringBuilder
    result = StringBuilder()
    result.append(self.build())
    result
  end
end

final class ByteBuffer implements Copyable
  def append(mut self, byte: Int): ByteBuffer
    intrinsic("byte_buffer.append", self, byte)
  end

  def extend(mut self, bytes: Bytes): ByteBuffer
    intrinsic("byte_buffer.extend", self, bytes)
  end

  def reserve(mut self, additional: Int): ByteBuffer
    intrinsic("byte_buffer.reserve", self, additional)
  end

  def set(mut self, index: Int, byte: Int): ByteBuffer
    intrinsic("byte_buffer.set", self, index, byte)
  end

  def capacity(self): Int
    intrinsic("byte_buffer.capacity", self)
  end

  def truncate(mut self, length: Int): ByteBuffer
    intrinsic("byte_buffer.truncate", self, length)
  end

  def clear(mut self): ByteBuffer
    intrinsic("byte_buffer.clear", self)
  end

  def len(self): Int
    intrinsic("byte_buffer.len", self)
  end

  def at(self, index: Int): Option[Int]
    value = intrinsic("byte_buffer.at", self, index)
    if value < 0
      None
    else
      Some(value)
    end
  end

  def at_or(self, index: Int, default: Int): Int
    value = intrinsic("byte_buffer.at", self, index)
    if value < 0
      default
    else
      value
    end
  end

  def find_from(self, needle: Bytes, start: Int): Option[Int]
    value = intrinsic("byte_buffer.find_from", self, needle, start)
    if value < 0
      None
    else
      Some(value)
    end
  end

  def find_from_or(self, needle: Bytes, start: Int, default: Int): Int
    value = intrinsic("byte_buffer.find_from", self, needle, start)
    if value < 0
      default
    else
      value
    end
  end

  def build(self): Bytes
    intrinsic("byte_buffer.build", self)
  end

  def finish(mut self): Bytes
    intrinsic("byte_buffer.finish", self)
  end

  def copy(self): ByteBuffer
    result = ByteBuffer()
    result.extend(self.build())
    result
  end
end
