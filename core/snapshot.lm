# Core: snapshot and restore results.
#
# A snapshot copies one machine world at one moment and persists the
# copy (specification 17.1). The conditions that block a copy are
# ordinary typed errors, not machine faults (17.4). `RunSnapshot[T]` and
# `VmSnapshot` are native snapshot types declared by the ABI.

enum SnapshotError implements Error
  # A live host attachment has no bytes to copy. The path names the
  # machine ordinals from the snapshot root to the machine that holds
  # the attachment. The kind names the attachment.
  ResourceActive(path: List[Int], kind: String)
  # The capture passed the configured snapshot byte limit.
  SnapshotLimitExceeded
  # External bytes did not pass the load checks of 17.8.
  BadImage(reason: String)

  def is_resource_active(self): Bool
    case self
    in ResourceActive(_, _)  then true
    in SnapshotLimitExceeded then false
    in BadImage(_)           then false
    end
  end

  def append_to(self, mut builder: StringBuilder)
    case self
    in ResourceActive(_, kind)
      builder.append("a live ")
      builder.append(kind)
      builder.append(" blocks snapshot creation")
    in SnapshotLimitExceeded
      builder.append("the snapshot exceeds its byte limit")
    in BadImage(reason)
      builder.append(reason)
    end
  end
end

# The ordinary error of a restore.
enum RestoreError implements Error
  # The restored world passed a machine, heap, or graph limit.
  RestoreLimitExceeded
  # The snapshot does not select a run to restore.
  IncompatibleImage

  def append_to(self, mut builder: StringBuilder)
    case self
    in RestoreLimitExceeded
      builder.append("the restored world exceeds its limit")
    in IncompatibleImage
      builder.append("the snapshot does not select a run to restore")
    end
  end
end

# The ordinary error of an in-memory run branch.
enum BranchError implements Error
  # A live host attachment cannot move into a branch.
  ResourceActive(path: List[Int], kind: String)
  # The copied world passed a machine, image, heap, or graph limit.
  BranchLimitExceeded

  def is_resource_active(self): Bool
    case self
    in ResourceActive(_, _)  then true
    in BranchLimitExceeded   then false
    end
  end

  def append_to(self, mut builder: StringBuilder)
    case self
    in ResourceActive(_, kind)
      builder.append("a live ")
      builder.append(kind)
      builder.append(" blocks branch creation")
    in BranchLimitExceeded
      builder.append("the branch exceeds its machine-world limit")
    end
  end
end
