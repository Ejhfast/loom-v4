# Core: verified code values and live installation handles.

final class Artifact
end

final class VerifiedModule
end

final class FunctionCode[F]
end

final class ClassCode
end

# A class implements this marker to join test discovery.
interface Test
end

# Descriptor categories use a closed value instead of text.
enum CodeKind
  Class
  Enum
  Interface
  Function
  Constant
  Method
end

# One module linked in this machine.
frozen class ModuleCode
end

# Inert descriptions of exact source definitions.
frozen class DeclarationCode
end

frozen class MemberCode
end

# One descriptor opened against a linked module.
frozen class OpenCode
end

final class DefinitionIdentity
  module_name: String
  qualified_key: String
  contract_hash: Digest
  implementation_hash: Digest

  def init(
    mut self,
    module_name: String,
    qualified_key: String,
    contract_hash: Digest,
    implementation_hash: Digest
  )
    self.module_name = module_name
    self.qualified_key = qualified_key
    self.contract_hash = contract_hash
    self.implementation_hash = implementation_hash
  end
end

final class DefinitionSpec
  identity: DefinitionIdentity
  module_hash: Digest
  slots: List[SlotSpec]

  def init(
    mut self,
    identity: DefinitionIdentity,
    module_hash: Digest,
    slots: List[SlotSpec]
  )
    self.identity = identity
    self.module_hash = module_hash
    self.slots = slots
  end
end

final class DefinitionSource
  path: String
  syntax: SyntaxNode
  definition: DefinitionSpec

  def init(
    mut self,
    path: String,
    syntax: SyntaxNode,
    definition: DefinitionSpec
  )
    self.path = path
    self.syntax = syntax
    self.definition = definition
  end
end

final class SlotSpec
end

final class Instance
end

final class Slot
end

final class SlotChange
end

final class FunctionDef[A, T]
end

final class ClassDef
end

final class FunctionBinding[A, T]
end

final class ClassBinding
end

final class CodeError implements Error
  message: String

  def init(mut self, message: String)
    self.message = message
  end

  def append_to(self, mut builder: StringBuilder)
    builder.append(self.message)
  end
end
