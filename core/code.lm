# Core: verified code values and live installation handles.

final class Artifact
end

final class VerifiedModule
end

final class FunctionCode[A, T]
end

final class ClassCode
end

final class DefinitionSpec
  module_name: String
  qualified_key: String
  contract: Digest
  slots: List[SlotSpec]

  def init(
    mut self,
    module_name: String,
    qualified_key: String,
    contract: Digest,
    slots: List[SlotSpec]
  )
    self.module_name = module_name
    self.qualified_key = qualified_key
    self.contract = contract
    self.slots = slots
  end
end

final class DefinitionSource
  path: String
  syntax: SyntaxNode
  contract: Digest
  slots: List[SlotSpec]

  def init(
    mut self,
    path: String,
    syntax: SyntaxNode,
    contract: Digest,
    slots: List[SlotSpec]
  )
    self.path = path
    self.syntax = syntax
    self.contract = contract
    self.slots = slots
  end
end

final class SlotSpec
end

