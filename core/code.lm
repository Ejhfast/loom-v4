# Core: verified code values and live installation handles.

final class Artifact
end

final class VerifiedModule
end

final class FunctionCode[A, T]
end

final class ClassCode
end

final class DefinitionSource
  path: String
  syntax: SyntaxNode
  contract: Digest
  slots: List[SlotSpec]

  def init(
    mut self,
    path: String,
    syntax: SyntaxNode,
    contract: Digest,
    slots: List[SlotSpec]
  )
    self.path = path
    self.syntax = syntax
    self.contract = contract
    self.slots = slots
  end
end

final class SlotSpec
end

final class Instance
end

final class Slot
end

final class FunctionDef[A, T]
end

final class ClassDef
end

final class CodeError
  message: String

  def init(mut self, message: String)
    self.message = message
  end
end
