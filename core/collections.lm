final class MapEntries[K: Hashable, V] implements Counted, Iterable
  type Item = (K, V)
  type Iter = MapEntriesIterator[K, V]

  source: Map[K, V]
  epoch: Int

  def init(mut self, source: Map[K, V])
    self.source = source
    self.epoch = intrinsic("map.epoch", source)
  end

  def len(self): Int
    intrinsic("map.iter_len", self.source, self.epoch)
  end

  def at(self, index: Int): (K, V)
    intrinsic("map.iter_len", self.source, self.epoch)
    position = _map_view_index(self.source, index, self.epoch)
    (
      intrinsic("map.key_at", self.source, position),
      intrinsic("map.value_at", self.source, position)
    )
  end

  def get(self, index: Int): Option[(K, V)]
    length = intrinsic("map.iter_len", self.source, self.epoch)
    if index < 0 or index >= length
      None
    else
      position = _map_view_index(self.source, index, self.epoch)
      Some((
        intrinsic("map.key_at", self.source, position),
        intrinsic("map.value_at", self.source, position)
      ))
    end
  end

  def iterator(self): MapEntriesIterator[K, V]
    intrinsic("map.iter_len", self.source, self.epoch)
    MapEntriesIterator[K, V](self.source, self.epoch)
  end
end

final class MapKeysIterator[K: Hashable, V] implements Iterator
  type Item = K

  source: Map[K, V]
  index: Int
  epoch: Int

  def init(mut self, source: Map[K, V], epoch: Int)
    self.source = source
    self.index = 0
    self.epoch = epoch
  end

  def next(mut self): Option[K]
    position = intrinsic("map.next_index", self.source, self.index, self.epoch)
    if position >= 0
      value = intrinsic("map.key_at", self.source, position)
      self.index = position + 1
      Some(value)
    else
      None
    end
  end
end

final class MapValuesIterator[K: Hashable, V] implements Iterator
  type Item = V

  source: Map[K, V]
  index: Int
  epoch: Int

  def init(mut self, source: Map[K, V], epoch: Int)
    self.source = source
    self.index = 0
    self.epoch = epoch
  end

  def next(mut self): Option[V]
    position = intrinsic("map.next_index", self.source, self.index, self.epoch)
    if position >= 0
      value = intrinsic("map.value_at", self.source, position)
      self.index = position + 1
      Some(value)
    else
      None
    end
  end
end

final class MapEntriesIterator[K: Hashable, V] implements Iterator
  type Item = (K, V)

  source: Map[K, V]
  index: Int
  epoch: Int

  def init(mut self, source: Map[K, V], epoch: Int)
    self.source = source
    self.index = 0
    self.epoch = epoch
  end

  def next(mut self): Option[(K, V)]
    position = intrinsic("map.next_index", self.source, self.index, self.epoch)
    if position >= 0
      key = intrinsic("map.key_at", self.source, position)
      value = intrinsic("map.value_at", self.source, position)
      self.index = position + 1
      Some((key, value))
    else
      None
    end
  end
end

def list_with_capacity[T](capacity: Int): List[T]
  result = List[T]()
  result.reserve(capacity)
  result
end

def list_repeated[T](value: T, count: Int): List[T]
  result = List[T]()
  result.reserve(count)
  index = 0
  while index < count
    result.push(value)
    index = index + 1
  end
  result
end

def map_with_capacity[K: Hashable, V](capacity: Int): Map[K, V]
  result = Map[K, V]()
  result.reserve(capacity)
  result
end

def set_from_list[T: Hashable](values: List[T]): Set[T]
  result = Set[T]()
  result.reserve(values.len())
  result.add_all(values)
  result
end
