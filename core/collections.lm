# Core collection contracts and native collection classes.

interface Iterator
  type Item
  def next(mut self): Option[Self.Item]
end

interface Iterable
  type Item
  type Iter: Iterator
  def iterator(self): Self.Iter
end

interface Counted
  def len(self): Int
end

final class List[T] implements Counted, Iterable, Copyable,
                               Display when T: Display,
                               PartialEq when T: PartialEq,
                               Hashable when T: Hashable,
                               Comparable when T: Comparable
  type Item = T
  type Iter = ListIterator[T]

  def len(self): Int
    intrinsic("list.len", self)
  end

  def capacity(self): Int
    intrinsic("list.capacity", self)
  end

  def is_empty(self): Bool
    self.len() == 0
  end

  def at(self, index: Int): T
    intrinsic("list.at", self, index)
  end

  def get(self, index: Int): Option[T]
    intrinsic("list.get", self, index)
  end

  def first(self): Option[T]
    self.get(0)
  end

  def last(self): Option[T]
    if self.len() == 0
      None
    else
      self.get(self.len() - 1)
    end
  end

  def set(mut self, index: Int, value: T)
    intrinsic("list.set", self, index, value)
  end

  def push(mut self, value: T)
    intrinsic("list.push", self, value)
  end

  def pop(mut self): Option[T]
    intrinsic("list.pop", self)
  end

  def insert(mut self, index: Int, value: T)
    intrinsic("list.insert", self, index, value)
  end

  def remove(mut self, index: Int): T
    intrinsic("list.remove", self, index)
  end

  def swap_remove(mut self, index: Int): T
    intrinsic("list.swap_remove", self, index)
  end

  def reserve(mut self, additional: Int)
    intrinsic("list.reserve", self, additional)
  end

  def truncate(mut self, length: Int)
    intrinsic("list.truncate", self, length)
  end

  def clear(mut self)
    self.truncate(0)
  end

  def copy(self): List[T]
    result = List[T]()
    result.reserve(self.len())
    for value in self
      result.push(value)
    end
    result
  end

  def append_to(self, mut builder: StringBuilder) when T: Display
    builder.append("[")
    index = 0
    while index < self.len()
      if index > 0
        builder.append(", ")
        ()
      end
      self.at(index).append_to(builder)
      index = index + 1
    end
    builder.append("]")
    ()
  end

  def __eq__(self, other: List[T]): Bool when T: PartialEq
    if self.len() != other.len()
      return false
    end
    index = 0
    while index < self.len()
      if not (self.at(index) == other.at(index))
        return false
      end
      index = index + 1
    end
    true
  end

  def __hash__(self): Int when T: Hashable
    hash = hash_combine(17, self.len())
    index = 0
    while index < self.len()
      hash = hash_combine(hash, self.at(index).__hash__())
      index = index + 1
    end
    hash
  end

  def compare(self, other: List[T]): Ordering when T: Comparable
    length = self.len()
    if other.len() < length
      length = other.len()
    end
    index = 0
    while index < length
      ordering = self.at(index).compare(other.at(index))
      if not ordering.is_equal()
        return ordering
      end
      index = index + 1
    end
    if self.len() < other.len()
      Less
    elsif self.len() > other.len()
      Greater
    else
      Equal
    end
  end

  def slice(self, start: Int, length: Int): List[T]
    if start < 0 or length < 0 or start > self.len() - length
      self.at(-1)
      ()
    end
    result = List[T]()
    result.reserve(length)
    index = 0
    while index < length
      result.push(self.at(start + index))
      index = index + 1
    end
    result
  end

  def slice_view(self, start: Int, length: Int): ListSlice[T]
    ListSlice[T](self, start, length)
  end

  def concat(self, other: List[T]): List[T]
    result = self.copy()
    result.extend(other)
    result
  end

  def extend(mut self, other: List[T])
    index = 0
    length = other.len()
    self.reserve(length)
    while index < length
      self.push(other.at(index))
      index = index + 1
    end
  end

  def reverse(mut self)
    left = 0
    right = self.len() - 1
    if right > 0
      intrinsic("list.reorder", self)
    end
    while left < right
      first = self.at(left)
      last = self.at(right)
      self.set(left, last)
      self.set(right, first)
      left = left + 1
      right = right - 1
    end
  end

  def contains(self, value: T): Bool
    intrinsic("list.contains", self, value)
  end

  def position[effect e](self, predicate: (T) -> Bool with e): Option[Int] with e
    index = 0
    for value in self
      if predicate(value)
        return Some(index)
      end
      index = index + 1
    end
    None
  end

  def find[effect e](self, predicate: (T) -> Bool with e): Option[T] with e
    for value in self
      if predicate(value)
        return Some(value)
      end
    end
    None
  end

  def each[effect e](self, f: (T) -> () with e): () with e
    for value in self
      f(value)
    end
    ()
  end

  def map[U, effect e](self, f: (T) -> U with e): List[U] with e
    result = List[U]()
    result.reserve(self.len())
    for value in self
      result.push(f(value))
    end
    result
  end

  def filter[effect e](self, f: (T) -> Bool with e): List[T] with e
    result = List[T]()
    for value in self
      if f(value)
        result.push(value)
      end
    end
    result
  end

  def filter_map[U, effect e](self, f: (T) -> Option[U] with e): List[U] with e
    result = List[U]()
    for value in self
      case f(value)
      in Some(mapped) then result.push(mapped)
      in None then ()
      end
    end
    result
  end

  def fold[U, effect e](self, initial: U, f: (U, T) -> U with e): U with e
    result = initial
    for value in self
      result = f(result, value)
    end
    result
  end

  def any[effect e](self, f: (T) -> Bool with e): Bool with e
    for value in self
      if f(value)
        return true
      end
    end
    false
  end

  def all[effect e](self, f: (T) -> Bool with e): Bool with e
    for value in self
      if not f(value)
        return false
      end
    end
    true
  end

  def sort_by[effect e](mut self, compare: (T, T) -> Ordering with e): () with e
    length = self.len()
    if length < 2
      return
    end
    epoch = intrinsic("list.epoch", self)
    source = self.copy()
    width = 1
    while width < length
      result = List[T]()
      result.reserve(length)
      left = 0
      while left < length
        middle = left + width
        if middle > length
          middle = length
        end
        right = middle + width
        if right > length
          right = length
        end
        first = left
        second = middle
        while first < middle and second < right
          if compare(source.at(first), source.at(second)).is_greater()
            result.push(source.at(second))
            second = second + 1
          else
            result.push(source.at(first))
            first = first + 1
          end
        end
        while first < middle
          result.push(source.at(first))
          first = first + 1
        end
        while second < right
          result.push(source.at(second))
          second = second + 1
        end
        left = right
      end
      source = result
      if width > length / 2
        width = length
      else
        width = width + width
      end
    end
    intrinsic("list.iter_len", self, epoch)
    intrinsic("list.reorder", self)
    index = 0
    while index < length
      self.set(index, source.at(index))
      index = index + 1
    end
    ()
  end

  def sort(mut self) when T: Comparable
    length = self.len()
    if length < 2
      return
    end
    epoch = intrinsic("list.epoch", self)
    source = self.copy()
    width = 1
    while width < length
      result = List[T]()
      result.reserve(length)
      left = 0
      while left < length
        middle = left + width
        if middle > length
          middle = length
        end
        right = middle + width
        if right > length
          right = length
        end
        first = left
        second = middle
        while first < middle and second < right
          if source.at(first).compare(source.at(second)).is_greater()
            result.push(source.at(second))
            second = second + 1
          else
            result.push(source.at(first))
            first = first + 1
          end
        end
        while first < middle
          result.push(source.at(first))
          first = first + 1
        end
        while second < right
          result.push(source.at(second))
          second = second + 1
        end
        left = right
      end
      source = result
      if width > length / 2
        width = length
      else
        width = width + width
      end
    end
    intrinsic("list.iter_len", self, epoch)
    intrinsic("list.reorder", self)
    index = 0
    while index < length
      self.set(index, source.at(index))
      index = index + 1
    end
    ()
  end

  def min(self): Option[T] when T: Comparable
    if self.is_empty()
      return None
    end
    result = self.at(0)
    index = 1
    while index < self.len()
      value = self.at(index)
      if value.compare(result).is_less()
        result = value
      end
      index = index + 1
    end
    Some(result)
  end

  def max(self): Option[T] when T: Comparable
    if self.is_empty()
      return None
    end
    result = self.at(0)
    index = 1
    while index < self.len()
      value = self.at(index)
      if value.compare(result).is_greater()
        result = value
      end
      index = index + 1
    end
    Some(result)
  end

  def iterator(self): ListIterator[T]
    ListIterator[T](self, intrinsic("list.epoch", self))
  end
end

final class Map[K: Hashable, V] implements Counted, Iterable, Copyable,
                                          Display when K: Display, V: Display,
                                          PartialEq when V: PartialEq,
                                          Hashable when V: Hashable
  type Item = (K, V)
  type Iter = MapIterator[K, V]

  def len(self): Int
    intrinsic("map.len", self)
  end

  def is_empty(self): Bool
    self.len() == 0
  end

  def has(self, key: K): Bool
    intrinsic("map.has", self, key)
  end

  def at(self, key: K): V
    intrinsic("map.at", self, key)
  end

  def get(self, key: K): Option[V]
    intrinsic("map.get", self, key)
  end

  def put(mut self, key: K, value: V): Option[V]
    intrinsic("map.put", self, key, value)
  end

  def get_or_insert_with[effect e](
    mut self,
    key: K,
    f: () -> V with e
  ): V with e
    case self.get(key)
    in Some(value)
      value
    in None
      value = f()
      self.put(key, value)
      value
    end
  end

  def remove(mut self, key: K): Option[V]
    intrinsic("map.remove", self, key)
  end

  def clear(mut self)
    intrinsic("map.clear", self)
  end

  def reserve(mut self, additional: Int)
    intrinsic("map.reserve", self, additional)
  end

  # A new map with the same entries in the same order. The copy shares
  # no storage, so a later change to one map leaves the other alone.
  def copy(self): Map[K, V]
    result = Map[K, V]()
    result.reserve(self.len())
    for key, value in self
      result.put(key, value)
    end
    result
  end

  def append_to(self, mut builder: StringBuilder) when K: Display, V: Display
    builder.append("{")
    index = 0
    for key, value in self
      if index > 0
        builder.append(", ")
        ()
      end
      key.append_to(builder)
      builder.append(": ")
      value.append_to(builder)
      index = index + 1
    end
    builder.append("}")
    ()
  end

  def __eq__(self, other: Map[K, V]): Bool when V: PartialEq
    if self.len() != other.len()
      return false
    end
    for key, value in self
      case other.get(key)
      in Some(other_value)
        if not (value == other_value)
          return false
        end
      in None
        return false
      end
    end
    true
  end

  def __hash__(self): Int when V: Hashable
    hash = 0
    for key, value in self
      entry = hash_combine(key.__hash__(), value.__hash__())
      hash = intrinsic("hash.unordered_combine", hash, entry)
    end
    hash_combine(self.len(), hash)
  end

  def keys(self): MapKeys[K, V]
    MapKeys[K, V](self)
  end

  def values(self): MapValues[K, V]
    MapValues[K, V](self)
  end

  def entries(self): MapEntries[K, V]
    MapEntries[K, V](self)
  end

  def keys_list(self): List[K]
    result = List[K]()
    result.reserve(self.len())
    for key, value in self
      result.push(key)
    end
    result
  end

  def values_list(self): List[V]
    result = List[V]()
    result.reserve(self.len())
    for key, value in self
      result.push(value)
    end
    result
  end

  def entries_list(self): List[(K, V)]
    result = List[(K, V)]()
    result.reserve(self.len())
    for key, value in self
      result.push((key, value))
    end
    result
  end

  def each[effect e](self, f: (K, V) -> () with e): () with e
    for key, value in self
      f(key, value)
    end
    ()
  end

  def map_values[U, effect e](self, f: (K, V) -> U with e): Map[K, U] with e
    result = Map[K, U]()
    result.reserve(self.len())
    for key, value in self
      result.put(key, f(key, value))
    end
    result
  end

  def retain[effect e](mut self, f: (K, V) -> Bool with e): () with e
    removed = List[K]()
    for key, value in self
      if not f(key, value)
        removed.push(key)
      end
    end
    for key in removed
      self.remove(key)
    end
    ()
  end

  def iterator(self): MapIterator[K, V]
    MapIterator[K, V](self, intrinsic("map.epoch", self))
  end
end

final class Set[T: Hashable] implements Counted, Iterable, PartialEq, Hashable, Copyable,
                                      Display when T: Display
  type Item = T
  type Iter = SetIterator[T]

  items: Map[T, ()] = {}

  def len(self): Int
    self.items.len()
  end

  def is_empty(self): Bool
    self.items.is_empty()
  end

  def has(self, value: T): Bool
    self.items.has(value)
  end

  # Return true when this call adds a new value.
  def add(mut self, value: T): Bool
    case self.items.put(value, ())
    in Some(_) then false
    in None then true
    end
  end

  # Return true when this call removes a value.
  def remove(mut self, value: T): Bool
    case self.items.remove(value)
    in Some(_) then true
    in None then false
    end
  end

  def clear(mut self)
    self.items.clear()
  end

  def reserve(mut self, additional: Int)
    self.items.reserve(additional)
  end

  def copy(self): Set[T]
    result = Set[T]()
    result.reserve(self.len())
    for value in self
      changed = result.add(value)
    end
    result
  end

  def append_to(self, mut builder: StringBuilder) when T: Display
    builder.append("Set[")
    index = 0
    for value in self
      if index > 0
        builder.append(", ")
        ()
      end
      value.append_to(builder)
      index = index + 1
    end
    builder.append("]")
    ()
  end

  def values(self): List[T]
    self.items.keys_list()
  end

  def each[effect e](self, f: (T) -> () with e): () with e
    for value in self
      f(value)
    end
    ()
  end

  def add_all(mut self, values: List[T])
    for value in values
      changed = self.add(value)
    end
  end

  def retain[effect e](mut self, f: (T) -> Bool with e): () with e
    removed = List[T]()
    for value in self
      if not f(value)
        removed.push(value)
      end
    end
    for value in removed
      changed = self.remove(value)
    end
    ()
  end

  def union(self, other: Set[T]): Set[T]
    result = self.copy()
    for value in other
      changed = result.add(value)
    end
    result
  end

  def intersection(self, other: Set[T]): Set[T]
    result = Set[T]()
    result.reserve(self.len())
    for value in self
      if other.has(value)
        changed = result.add(value)
      end
    end
    result
  end

  def difference(self, other: Set[T]): Set[T]
    result = Set[T]()
    result.reserve(self.len())
    for value in self
      if not other.has(value)
        changed = result.add(value)
      end
    end
    result
  end

  def is_subset(self, other: Set[T]): Bool
    if self.len() > other.len()
      return false
    end
    for value in self
      if not other.has(value)
        return false
      end
    end
    true
  end

  def is_superset(self, other: Set[T]): Bool
    other.is_subset(self)
  end

  def is_disjoint(self, other: Set[T]): Bool
    for value in self
      if other.has(value)
        return false
      end
    end
    true
  end

  def __eq__(self, other: Set[T]): Bool
    self.len() == other.len() and self.is_subset(other)
  end

  def __hash__(self): Int
    hash = 0
    for value in self
      hash = intrinsic("hash.unordered_combine", hash, value.__hash__())
    end
    hash_combine(self.len(), hash)
  end

  def iterator(self): SetIterator[T]
    SetIterator[T](self.items.keys().iterator())
  end
end

final class ListIterator[T] implements Iterator
  type Item = T

  source: List[T]
  index: Int
  epoch: Int

  def init(mut self, source: List[T], epoch: Int)
    self.source = source
    self.index = 0
    self.epoch = epoch
  end

  def next(mut self): Option[T]
    if self.index < intrinsic("list.iter_len", self.source, self.epoch)
      value = intrinsic("list.at", self.source, self.index)
      self.index = self.index + 1
      Some(value)
    else
      None
    end
  end
end

final class MapIterator[K: Hashable, V] implements Iterator
  type Item = (K, V)

  source: Map[K, V]
  index: Int
  epoch: Int

  def init(mut self, source: Map[K, V], epoch: Int)
    self.source = source
    self.index = 0
    self.epoch = epoch
  end

  def next(mut self): Option[(K, V)]
    position = intrinsic("map.next_index", self.source, self.index, self.epoch)
    if position >= 0
      key = intrinsic("map.key_at", self.source, position)
      value = intrinsic("map.value_at", self.source, position)
      self.index = position + 1
      Some((key, value))
    else
      None
    end
  end
end

def _map_view_index[K: Hashable, V](
  source: Map[K, V],
  index: Int,
  epoch: Int
): Int
  if index < 0
    return -1
  end
  cursor = 0
  ordinal = 0
  while ordinal <= index
    position = intrinsic("map.next_index", source, cursor, epoch)
    if position < 0
      return -1
    end
    if ordinal == index
      return position
    end
    cursor = position + 1
    ordinal = ordinal + 1
  end
  -1
end

final class SetIterator[T: Hashable] implements Iterator
  type Item = T

  source: MapKeysIterator[T, ()]

  def init(mut self, source: MapKeysIterator[T, ()])
    self.source = source
  end

  def next(mut self): Option[T]
    self.source.next()
  end
end

final class TextIterator implements Iterator
  type Item = Char

  source: Text
  cursor: Int

  def init(mut self, source: Text)
    self.source = source
    self.cursor = 0
  end

  def next(mut self): Option[Char]
    if self.cursor < self.source.byte_len()
      value = intrinsic("text.at_byte", self.source, self.cursor)
      self.cursor = self.cursor + value.utf8_len()
      Some(value)
    else
      None
    end
  end
end

final class RangeIterator implements Iterator
  type Item = Int

  next_value: Int
  stop: Int

  def init(mut self, start: Int, stop: Int)
    self.next_value = start
    self.stop = stop
  end

  def next(mut self): Option[Int]
    if self.next_value < self.stop
      value = self.next_value
      self.next_value = self.next_value + 1
      Some(value)
    else
      None
    end
  end
end

final class ListSlice[T] implements Counted, Iterable,
                                    Display when T: Display,
                                    PartialEq when T: PartialEq,
                                    Comparable when T: Comparable
  type Item = T
  type Iter = ListSliceIterator[T]

  source: List[T]
  start: Int
  length: Int
  epoch: Int

  def init(mut self, source: List[T], start: Int, length: Int)
    if start < 0 or length < 0 or start > source.len() - length
      source.at(-1)
      ()
    end
    self.source = source
    self.start = start
    self.length = length
    self.epoch = intrinsic("list.epoch", source)
  end

  def len(self): Int
    intrinsic("list.iter_len", self.source, self.epoch)
    self.length
  end

  def is_empty(self): Bool
    self.len() == 0
  end

  def at(self, index: Int): T
    intrinsic("list.iter_len", self.source, self.epoch)
    if index < 0 or index >= self.length
      self.source.at(-1)
      ()
    end
    self.source.at(self.start + index)
  end

  def get(self, index: Int): Option[T]
    intrinsic("list.iter_len", self.source, self.epoch)
    if index < 0 or index >= self.length
      None
    else
      Some(self.source.at(self.start + index))
    end
  end

  def copy(self): List[T]
    result = List[T]()
    result.reserve(self.len())
    for value in self
      result.push(value)
    end
    result
  end

  def append_to(self, mut builder: StringBuilder) when T: Display
    builder.append("[")
    index = 0
    while index < self.len()
      if index > 0
        builder.append(", ")
        ()
      end
      self.at(index).append_to(builder)
      index = index + 1
    end
    builder.append("]")
    ()
  end

  def __eq__(self, other: ListSlice[T]): Bool when T: PartialEq
    if self.len() != other.len()
      return false
    end
    index = 0
    while index < self.len()
      if not (self.at(index) == other.at(index))
        return false
      end
      index = index + 1
    end
    true
  end

  def compare(self, other: ListSlice[T]): Ordering when T: Comparable
    length = self.len()
    if other.len() < length
      length = other.len()
    end
    index = 0
    while index < length
      ordering = self.at(index).compare(other.at(index))
      if not ordering.is_equal()
        return ordering
      end
      index = index + 1
    end
    if self.len() < other.len()
      Less
    elsif self.len() > other.len()
      Greater
    else
      Equal
    end
  end

  def iterator(self): ListSliceIterator[T]
    intrinsic("list.iter_len", self.source, self.epoch)
    ListSliceIterator[T](self.source, self.start, self.length, self.epoch)
  end
end

final class ListSliceIterator[T] implements Iterator
  type Item = T

  source: List[T]
  start: Int
  length: Int
  index: Int
  epoch: Int

  def init(
    mut self,
    source: List[T],
    start: Int,
    length: Int,
    epoch: Int
  )
    self.source = source
    self.start = start
    self.length = length
    self.index = 0
    self.epoch = epoch
  end

  def next(mut self): Option[T]
    intrinsic("list.iter_len", self.source, self.epoch)
    if self.index < self.length
      value = self.source.at(self.start + self.index)
      self.index = self.index + 1
      Some(value)
    else
      None
    end
  end
end

final class MapKeys[K: Hashable, V] implements Counted, Iterable
  type Item = K
  type Iter = MapKeysIterator[K, V]

  source: Map[K, V]
  epoch: Int

  def init(mut self, source: Map[K, V])
    self.source = source
    self.epoch = intrinsic("map.epoch", source)
  end

  def len(self): Int
    intrinsic("map.iter_len", self.source, self.epoch)
  end

  def at(self, index: Int): K
    intrinsic("map.iter_len", self.source, self.epoch)
    intrinsic(
      "map.key_at",
      self.source,
      _map_view_index(self.source, index, self.epoch)
    )
  end

  def get(self, index: Int): Option[K]
    length = intrinsic("map.iter_len", self.source, self.epoch)
    if index < 0 or index >= length
      None
    else
      position = _map_view_index(self.source, index, self.epoch)
      Some(intrinsic("map.key_at", self.source, position))
    end
  end

  def iterator(self): MapKeysIterator[K, V]
    intrinsic("map.iter_len", self.source, self.epoch)
    MapKeysIterator[K, V](self.source, self.epoch)
  end
end

final class MapValues[K: Hashable, V] implements Counted, Iterable
  type Item = V
  type Iter = MapValuesIterator[K, V]

  source: Map[K, V]
