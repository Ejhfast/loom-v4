# Core: native unit and tuple method tables.

final class Unit implements Display, Hashable
  def append_to(self, mut builder: StringBuilder)
    builder.append("()")
    ()
  end

  def __eq__(self, other: Unit): Bool
    true
  end

  def __hash__(self): Int
    hash_combine(0, 0)
  end
end

final class Tuple2[A, B] implements Display when A: Display, B: Display,
  PartialEq when A: PartialEq, B: PartialEq,
  Hashable when A: Hashable, B: Hashable,
  Comparable when A: Comparable, B: Comparable
  def swap(self): (B, A)
    (self[1], self[0])
  end

  def append_to(self, mut builder: StringBuilder) when A: Display, B: Display
    builder.append("(")
    self[0].append_to(builder)
    builder.append(", ")
    self[1].append_to(builder)
    builder.append(")")
    ()
  end

  def __eq__(self, other: Tuple2[A, B]): Bool when A: PartialEq, B: PartialEq
    if not (self[0] == other[0])
      return false
    end
    if not (self[1] == other[1])
      return false
    end
    true
  end

  def __hash__(self): Int when A: Hashable, B: Hashable
    hash = hash_combine(2, self[0].__hash__())
    hash = hash_combine(hash, self[1].__hash__())
    hash
  end

  def compare(self, other: Tuple2[A, B]): Ordering when A: Comparable, B: Comparable
    ordering = self[0].compare(other[0])
    if not ordering.is_equal()
      return ordering
    end
    ordering = self[1].compare(other[1])
    if not ordering.is_equal()
      return ordering
    end
    Equal
  end
end

