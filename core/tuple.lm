# Core: native unit and tuple method tables.

final class Unit
end

final class Tuple2[A, B]
  def swap(self): (B, A)
    (self[1], self[0])
  end
end

final class Tuple3[A, B, C]
end

final class Tuple4[A, B, C, D]
end

final class Tuple5[A, B, C, D, E]
end

